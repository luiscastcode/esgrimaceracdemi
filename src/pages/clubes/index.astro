---
// src/pages/clubes/index.astro
import Layout from '../../layouts/LayoutBase.astro';
import { getTodosClubes } from '../../utils/dataLoader';
import estadosData from '../../data/estados.json';
import { FiMapPin, FiHome, FiChevronRight } from 'react-icons/fi';
import BannerPub from '../../components/BannerPub.astro';

// 🔥 ESTADOS
const ESTADOS = estadosData.estados || [];

const todosLosClubes = await getTodosClubes();
const titulo = 'Todos los clubes de esgrima en Venezuela';
const descripcion = 'Directorio completo de clubes de esgrima en todo el país.';
---

<Layout title={titulo} description={descripcion}>
  <div class="container mx-auto px-4 py-8">
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-primary transition-colors">
        <FiHome className="w-4 h-4 inline" />
        <span class="ml-1">Inicio</span>
      </a>
      <FiChevronRight className="w-4 h-4 text-gray-300" />
      <span>Clubes</span>
    </nav>

    <div class="bg-linear-to-r from-primary to-primary-light text-white rounded-2xl p-8 mb-8">
      <h1 class="text-3xl md:text-4xl font-bold font-heading mb-2">{titulo}</h1>
      <p class="text-gray-300 text-lg">{descripcion}</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {ESTADOS.map((estado) => {
        const clubesEnEstado = todosLosClubes.filter(c => 
          String(c.estado_slug || '').trim() === estado.slug
        );
        return (
          <a
            href={`/clubes/${estado.slug}`}
            class="bg-white rounded-xl shadow-md p-6 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 border border-gray-100 text-center group"
          >
            <div class="w-16 h-16 mx-auto bg-primary/10 rounded-full flex items-center justify-center mb-3 group-hover:bg-primary/20 transition-colors">
              <FiMapPin className="w-8 h-8 text-primary group-hover:text-orange-700 transition-colors" />
            </div>
            <h2 class="text-lg font-semibold text-primary group-hover:text-indigo-500 transition-colors">
              {estado.nombre}
            </h2>
            <p class="text-sm text-gray-500 mt-1">
              {clubesEnEstado.length} clubes
            </p>
          </a>
        );
      })}
    </div>
    <BannerPub 
      titulo="¿Quieres que tu marca llegue a todos los esgrimistas de Venezuela?"
      descripcion="Publica aquí y conecta con miles de atletas, clubes y entrenadores."
      texto="Contacta con nosotros"
      url="/contacto"
      target=" "
    />
  </div>
</Layout>