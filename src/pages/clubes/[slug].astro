---
// src/pages/clubes/[slug].astro
import Layout from "../../layouts/LayoutBase.astro";
import { getTodosClubes } from "../../utils/dataLoader";
import estadosData from "../../data/estados.json";
import {
  FiMapPin,
  FiCalendar,
  FiUser,
  FiClock,
  FiHome,
  FiChevronRight,
  FiStar,
  FiInfo,
  FiExternalLink,
  FiMail,
  FiPhone,
  FiMap,
  FiAward,
  FiUsers,
  FiImage,
  FiBriefcase,
} from "react-icons/fi";
import { FaInstagram, FaWhatsapp } from "react-icons/fa";

// 🔥 COMPONENTE DE MAPA (OPCIONAL)
// Si prefieres no usar Leaflet, comenta esta importación
// y usa el mapa de Google Maps embed simple
import MapaClub from "../../components/MapaClub.jsx";

const ESTADOS = estadosData.estados || [];

// 🔥 Genera todas las rutas
export async function getStaticPaths() {
  const ESTADOS = estadosData.estados || [];
  const todosLosClubes = await getTodosClubes();
  const paths: any[] = [];

  ESTADOS.forEach((estado) => {
    paths.push({ params: { slug: estado.slug } });

    estado.ciudades.forEach((ciudad) => {
      const ciudadSlug = ciudad.toLowerCase().replace(/\s+/g, "-");
      paths.push({ params: { slug: `${estado.slug}-${ciudadSlug}` } });

      const clubesEnCiudad = todosLosClubes.filter((c) => {
        const cEstado = String(c.estado_slug || "").trim();
        const cCiudad = String(c.ciudad_slug || "").trim();
        return cEstado === estado.slug && cCiudad === ciudadSlug;
      });

      clubesEnCiudad.forEach((club) => {
        const clubSlug = String(club.slug || club.id || "").trim();
        if (clubSlug) {
          paths.push({
            params: { slug: `${estado.slug}-${ciudadSlug}-${clubSlug}` },
          });
        }
      });
    });
  });

  return paths;
}

const { slug } = Astro.params;
const todosLosClubes = await getTodosClubes();

let mostrarEstado = false;
let mostrarCiudad = false;
let mostrarClub = false;

let titulo = "";
let descripcion = "";
let clubesMostrar: any[] = [];
let clubEspecifico = null;
let estadoInfo = null;
let estadoSlug = "";
let ciudadSlug = "";
let ciudadNombre = "";

if (slug) {
  const slugStr = String(slug).trim();

  estadoInfo = ESTADOS.find((e) => e.slug === slugStr);

  if (estadoInfo) {
    mostrarEstado = true;
    estadoSlug = estadoInfo.slug;
    titulo = `Esgrima en ${estadoInfo.nombre} | Horarios, Precios y Ubicación`;
    descripcion = `¿Buscas una escuela de esgrima? Clases para niños, jóvenes y adultos en ${estadoInfo.nombre}. Reserva tu clase gratis.`;
    clubesMostrar = todosLosClubes.filter(
      (c) => String(c.estado_slug || "").trim() === estadoSlug,
    );
  } else {
    let estadoMatch = null;
    let ciudadMatch = "";

    for (const estado of ESTADOS) {
      for (const ciudad of estado.ciudades) {
        const ciudadSlugTest = ciudad.toLowerCase().replace(/\s+/g, "-");
        const testSlug = `${estado.slug}-${ciudadSlugTest}`;
        if (testSlug === slugStr) {
          estadoMatch = estado;
          ciudadMatch = ciudad;
          break;
        }
      }
      if (estadoMatch) break;
    }

    if (estadoMatch && ciudadMatch) {
      mostrarCiudad = true;
      estadoInfo = estadoMatch;
      estadoSlug = estadoMatch.slug;
      ciudadSlug = ciudadMatch.toLowerCase().replace(/\s+/g, "-");
      ciudadNombre = ciudadMatch;

      titulo = `Esgrima en ${ciudadMatch}, ${estadoMatch.nombre} | Horarios, Precios y Ubicación`;
      descripcion = `¿Buscas una escuela de esgrima? Clases para niños, jóvenes y adultos en ${ciudadMatch}, ${estadoMatch.nombre}. Reserva tu clase gratis.`;
      clubesMostrar = todosLosClubes.filter(
        (c) =>
          String(c.estado_slug || "").trim() === estadoSlug &&
          String(c.ciudad_slug || "").trim() === ciudadSlug,
      );
    } else {
      for (const club of todosLosClubes) {
        const clubSlugTest = String(club.slug || club.id || "").trim();
        if (slugStr.endsWith(clubSlugTest) && clubSlugTest) {
          const estadoTest = String(club.estado_slug || "").trim();
          const ciudadTest = String(club.ciudad_slug || "").trim();
          const testSlug = `${estadoTest}-${ciudadTest}-${clubSlugTest}`;

          if (testSlug === slugStr) {
            mostrarClub = true;
            clubEspecifico = club;
            estadoSlug = estadoTest;
            ciudadSlug = ciudadTest;
            estadoInfo = ESTADOS.find((e) => e.slug === estadoTest);

            titulo = `${club.nombre} - Club de esgrima en ${club.ciudad}`;
            descripcion =
              club.descripcion ||
              `Club de esgrima ${club.especialidad} en ${club.ciudad}, ${club.estado}.`;
            break;
          }
        }
      }
    }
  }
}

// 🔥 FUNCIÓN PARA GENERAR URL DE MAPA ESTÁTICO (Google Maps embed)
function getGoogleMapsUrl(lat, lng, nombre) {
  return `https://www.google.com/maps/embed/v1/place?key=YOUR_GOOGLE_MAPS_API_KEY&q=${lat},${lng}&zoom=15`;
}

// 🔥 FUNCIÓN PARA LINK DE WAZE/GOOGLE MAPS
function getMapsLink(lat, lng) {
  return `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
}
---

<Layout title={titulo || "Página no encontrada"} description={descripcion}>
  <div class="container mx-auto px-4 py-8">
    {
      !mostrarEstado && !mostrarCiudad && !mostrarClub ? (
        // --- ERROR ---
        <div class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-8 text-center border border-border/50">
          <div class="w-20 h-20 mx-auto bg-surface-muted/40 rounded-2xl flex items-center justify-center mb-4">
            <i class="fa-solid fa-location-dot text-3xl text-text-soft"></i>
          </div>
          <h1 class="text-2xl font-bold font-heading mb-2 text-text">Página no encontrada</h1>
          <p class="text-text-muted">No se encontró la página solicitada.</p>
          <a
            href="/clubes"
            class="inline-flex items-center gap-1.5 text-primary hover:text-accent transition-colors mt-4 font-semibold"
          >
            Volver al directorio
            <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        </div>
      ) : mostrarEstado ? (
        // --- VISTA DE ESTADO ---
        <div>
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-sm text-text-muted mb-8 flex-wrap">
            <a href="/" class="hover:text-primary transition-colors inline-flex items-center gap-1">
              <i class="fa-solid fa-house text-xs"></i>
              <span>Inicio</span>
            </a>
            <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
            <a href="/clubes" class="hover:text-primary transition-colors">
              Clubes
            </a>
            <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
            <span class="text-primary font-medium">
              {estadoInfo?.nombre || estadoSlug}
            </span>
          </nav>

          <!-- Hero del estado -->
          <div class="bg-linear-to-r from-primary to-primary-light text-text-inverse rounded-3xl p-8 mb-8 shadow-lg shadow-primary/10">
            <h1 class="text-3xl md:text-4xl font-bold font-heading mb-2">
              {titulo}
            </h1>
            <p class="text-surface-muted text-lg">{descripcion}</p>
          </div>

          <!-- Grid de ciudades -->
          {estadoInfo?.ciudades && estadoInfo.ciudades.length > 0 && (
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mb-8">
              {estadoInfo.ciudades.map((ciudad) => {
                const ciudadSlugMap = ciudad.toLowerCase().replace(/\s+/g, "-");
                const clubesEnCiudad = todosLosClubes.filter(
                  (c) =>
                    String(c.estado_slug || "").trim() === estadoSlug &&
                    String(c.ciudad_slug || "").trim() === ciudadSlugMap,
                );
                return (
                  <a
                    href={`/clubes/${estadoSlug}-${ciudadSlugMap}`}
                    class="bg-surface rounded-2xl shadow-md shadow-primary/5 p-4 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1 transition-all duration-200 border border-border/50 hover:border-border text-center group"
                  >
                    <div class="w-16 h-16 mx-auto bg-surface-muted/50 rounded-2xl flex items-center justify-center mb-3 group-hover:bg-surface-muted transition-colors">
                      <i class="fa-solid fa-location-dot text-2xl text-primary group-hover:text-accent transition-colors"></i>
                    </div>
                    <h3 class="font-semibold text-text group-hover:text-primary-light transition-colors">
                      {ciudad}
                    </h3>
                    <p class="text-sm text-text-muted mt-1">
                      {clubesEnCiudad.length} clubes
                    </p>
                  </a>
                );
              })}
            </div>
          )}

          <!-- Todos los clubes -->
          <h2 class="text-2xl font-bold font-heading mb-6 text-text">Todos los clubes</h2>
          {clubesMostrar.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {clubesMostrar.map((club) => {
                const clubSlugMap = String(club.slug || club.id || "").trim();
                const ciudadSlugMap = String(club.ciudad_slug || "").trim();
                return (
                  <a
                    href={`/clubes/${estadoSlug}-${ciudadSlugMap}-${clubSlugMap}`}
                    class="bg-surface rounded-2xl shadow-md shadow-primary/5 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1.5 transition-all duration-300 border border-border/50 hover:border-border group overflow-hidden"
                  >
                    {club.imagen_portada && (
                      <div class="h-32 bg-surface-muted/40 overflow-hidden">
                        <img
                          src={club.imagen_portada}
                          alt={club.nombre}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="p-6">
                      <div class="flex items-start justify-between gap-2">
                        <div class="flex items-center gap-3">
                          {club.logo && (
                            <img
                              src={club.logo}
                              alt={club.nombre}
                              class="w-12 h-12 rounded-2xl object-cover border-2 border-surface-muted bg-surface"
                              loading="lazy"
                            />
                          )}
                          <h3 class="text-xl font-bold text-text group-hover:text-primary-light transition-colors line-clamp-2">
                            {club.nombre}
                          </h3>
                        </div>
                        {club.destacado && (
                          <span class="flex items-center gap-1 text-xs bg-accent/10 text-accent px-2 py-1 rounded-full font-semibold whitespace-nowrap">
                            <i class="fa-solid fa-star text-[10px]"></i>
                            Destacado
                          </span>
                        )}
                      </div>
                      <p class="text-text-muted text-sm mt-1 flex items-center gap-1">
                        <i class="fa-solid fa-location-dot text-xs"></i>
                        {club.ciudad}
                      </p>
                      <div class="flex flex-wrap gap-2 mt-4">
                        <span class="text-xs bg-primary/10 text-primary px-3 py-1 rounded-full font-medium">
                          {club.especialidad}
                        </span>
                        <span class="text-xs bg-surface-muted/40 text-text-muted px-3 py-1 rounded-full flex items-center gap-1">
                          <i class="fa-regular fa-calendar text-[10px]"></i>
                          {club.edades}
                        </span>
                        {club.entrenadores && (
                          <span class="text-xs bg-primary-light/10 text-primary-light px-3 py-1 rounded-full flex items-center gap-1">
                            <i class="fa-solid fa-users text-[10px]"></i>
                            {club.entrenadores.length} entrenadores
                          </span>
                        )}
                      </div>
                      {club.descripcion && (
                        <p class="text-sm text-text-muted mt-3 line-clamp-2">
                          {club.descripcion}
                        </p>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          ) : (
            <div class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-12 text-center border-2 border-dashed border-border">
              <div class="w-20 h-20 mx-auto bg-surface-muted/40 rounded-2xl flex items-center justify-center mb-4">
                <i class="fa-solid fa-location-dot text-3xl text-text-soft"></i>
              </div>
              <p class="text-text-muted">
                No hay clubes registrados en este estado aún.
              </p>
            </div>
          )}
        </div>
      ) : mostrarCiudad ? (
        // --- VISTA DE CIUDAD ---
        <div>
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-sm text-text-muted mb-8 flex-wrap">
            <a href="/" class="hover:text-primary transition-colors inline-flex items-center gap-1">
              <i class="fa-solid fa-house text-xs"></i>
              <span>Inicio</span>
            </a>
            <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
            <a href="/clubes" class="hover:text-primary transition-colors">
              Clubes
            </a>
            <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
            <a
              href={`/clubes/${estadoSlug}`}
              class="hover:text-primary transition-colors"
            >
              {estadoInfo?.nombre}
            </a>
            <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
            <span class="text-primary font-medium">{ciudadNombre}</span>
          </nav>

          <!-- Hero de la ciudad -->
          <div class="bg-linear-to-r from-primary to-primary-light text-text-inverse rounded-3xl p-8 mb-8 shadow-lg shadow-primary/10">
            <h1 class="text-3xl md:text-4xl font-bold font-heading mb-2">
              {titulo}
            </h1>
            <p class="text-surface-muted text-lg">{descripcion}</p>
          </div>

          {clubesMostrar.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {clubesMostrar.map((club) => {
                const clubSlugMap = String(club.slug || club.id || "").trim();
                return (
                  <a
                    href={`/clubes/${estadoSlug}-${ciudadSlug}-${clubSlugMap}`}
                    class="bg-surface rounded-2xl shadow-md shadow-primary/5 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1.5 transition-all duration-300 border border-border/50 hover:border-border group overflow-hidden"
                  >
                    {club.imagen_portada && (
                      <div class="h-32 bg-surface-muted/40 overflow-hidden">
                        <img
                          src={club.imagen_portada}
                          alt={club.nombre}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="p-6">
                      <div class="flex items-start justify-between gap-2">
                        <div class="flex items-center gap-3">
                          {club.logo && (
                            <img
                              src={club.logo}
                              alt={club.nombre}
                              class="w-12 h-12 rounded-2xl object-cover border-2 border-surface-muted bg-surface"
                              loading="lazy"
                            />
                          )}
                          <h3 class="text-xl font-bold text-text group-hover:text-primary-light transition-colors">
                            {club.nombre}
                          </h3>
                        </div>
                        {club.destacado && (
                          <span class="flex items-center gap-1 text-xs bg-accent/10 text-accent px-2 py-1 rounded-full font-semibold whitespace-nowrap">
                            <i class="fa-solid fa-star text-[10px]"></i>
                            Destacado
                          </span>
                        )}
                      </div>
                      <div class="flex flex-wrap gap-2 mt-4">
                        <span class="text-xs bg-primary/10 text-primary px-3 py-1 rounded-full font-medium">
                          {club.especialidad}
                        </span>
                        <span class="text-xs bg-surface-muted/40 text-text-muted px-3 py-1 rounded-full flex items-center gap-1">
                          <i class="fa-regular fa-calendar text-[10px]"></i>
                          {club.edades}
                        </span>
                      </div>
                      {club.descripcion && (
                        <p class="text-sm text-text-muted mt-3 line-clamp-2">
                          {club.descripcion}
                        </p>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          ) : (
            <div class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-12 text-center border-2 border-dashed border-border">
              <div class="w-20 h-20 mx-auto bg-surface-muted/40 rounded-2xl flex items-center justify-center mb-4">
                <i class="fa-solid fa-location-dot text-3xl text-text-soft"></i>
              </div>
              <p class="text-text-muted">
                No hay clubes registrados en esta ciudad aún.
              </p>
            </div>
          )}
        </div>
      ) : mostrarClub && clubEspecifico ? (
        // --- VISTA DE CLUB (DETALLADA) ---
        <div>
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-sm text-text-muted mb-8 flex-wrap">
            <a href="/" class="hover:text-primary transition-colors inline-flex items-center gap-1">
              <i class="fa-solid fa-house text-xs"></i>
              <span>Inicio</span>
            </a>
            <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
            <a href="/clubes" class="hover:text-primary transition-colors">
              Clubes
            </a>
            <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
            <a
              href={`/clubes/${estadoSlug}`}
              class="hover:text-primary transition-colors"
            >
              {estadoInfo?.nombre}
            </a>
            <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
            <a
              href={`/clubes/${estadoSlug}-${ciudadSlug}`}
              class="hover:text-primary transition-colors capitalize"
            >
              {ciudadSlug?.replace(/-/g, " ")}
            </a>
            <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
            <span class="text-primary font-medium">
              {clubEspecifico.nombre}
            </span>
          </nav>

          <div class="bg-surface rounded-3xl shadow-md shadow-primary/5 border border-border/50 overflow-hidden">
            <!-- Imagen de Portada -->
            {clubEspecifico.imagen_portada && (
              <div class="w-full h-64 md:h-80 bg-surface-muted/40 overflow-hidden">
                <img
                  src={clubEspecifico.imagen_portada}
                  alt={clubEspecifico.nombre}
                  class="w-full h-full object-cover"
                />
              </div>
            )}

            <!-- Header del Club -->
            <div class="p-6 md:p-8">
              <div class="flex flex-col md:flex-row md:items-center gap-6">
                {clubEspecifico.logo && (
                  <img
                    src={clubEspecifico.logo}
                    alt={clubEspecifico.nombre}
                    class="w-24 h-24 rounded-3xl object-cover border-4 border-surface-muted bg-surface shrink-0"
                    loading="lazy"
                  />
                )}
                <div class="flex-1">
                  <div class="flex items-center gap-3 flex-wrap">
                    <h1 class="text-3xl md:text-4xl font-bold font-heading text-text">
                      {clubEspecifico.nombre}
                    </h1>
                    {clubEspecifico.destacado && (
                      <span class="flex items-center gap-1 text-sm bg-accent/10 text-accent px-3 py-1 rounded-full font-semibold">
                        <i class="fa-solid fa-star text-xs"></i>
                        Destacado
                      </span>
                    )}
                  </div>
                  <div class="flex flex-wrap gap-2 mt-3">
                    <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-sm flex items-center gap-1.5 font-medium">
                      <i class="fa-solid fa-location-dot text-xs"></i>
                      {clubEspecifico.especialidad}
                    </span>
                    <span class="bg-surface-muted/40 text-text-muted px-3 py-1 rounded-full text-sm flex items-center gap-1.5">
                      <i class="fa-solid fa-location-dot text-xs"></i>
                      {clubEspecifico.ciudad}, {clubEspecifico.estado}
                    </span>
                    <span class="bg-surface-muted/40 text-text-muted px-3 py-1 rounded-full text-sm flex items-center gap-1.5">
                      <i class="fa-regular fa-calendar text-xs"></i>
                      {clubEspecifico.edades}
                    </span>
                  </div>
                </div>
                <div class="flex flex-wrap gap-2">
                  {clubEspecifico.instagram && (
                    <a
                      href={clubEspecifico.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 px-4 py-2 bg-accent text-text-inverse rounded-xl hover:bg-accent-light transition text-sm font-semibold shadow-md shadow-accent/20"
                    >
                      <i class="fa-brands fa-instagram"></i>
                      Instagram
                    </a>
                  )}
                  {clubEspecifico.whatsapp && (
                    <a
                      href={clubEspecifico.whatsapp}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 px-4 py-2 bg-primary text-text-inverse rounded-xl hover:bg-primary-light transition text-sm font-semibold"
                    >
                      <i class="fa-brands fa-whatsapp"></i>
                      WhatsApp
                    </a>
                  )}
                  {clubEspecifico.web && (
                    <a
                      href={clubEspecifico.web}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 px-4 py-2 bg-surface-muted/60 text-primary rounded-xl hover:bg-surface-muted transition text-sm font-semibold border border-border/50"
                    >
                      <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                      Web
                    </a>
                  )}
                </div>
              </div>
            </div>

            <!-- Información Principal -->
            <div class="px-6 md:px-8 pb-6 grid grid-cols-1 md:grid-cols-3 gap-6">
              <!-- Ubicación -->
              <div class="bg-background rounded-2xl p-5 border border-border/40">
                <h3 class="font-semibold text-lg mb-3 flex items-center gap-2 text-text">
                  <i class="fa-solid fa-location-dot text-primary"></i>
                  Ubicación
                </h3>
                <p class="text-text-muted">{clubEspecifico.direccion}</p>
                {clubEspecifico.direccion_alternativa && (
                  <p class="text-text-muted text-sm mt-1">
                    {clubEspecifico.direccion_alternativa}
                  </p>
                )}
                {clubEspecifico.coordenadas && (
                  <div class="mt-3">
                    <a
                      href={getMapsLink(
                        clubEspecifico.coordenadas.lat,
                        clubEspecifico.coordenadas.lng,
                      )}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-text-inverse font-semibold text-sm bg-primary px-3 py-2 rounded-xl transition hover:bg-primary-light shadow-sm"
                    >
                      <i class="fa-solid fa-map"></i>
                      Cómo llegar
                    </a>

                    <div class="mt-3">
                      <MapaClub
                        lat={clubEspecifico.coordenadas.lat}
                        lng={clubEspecifico.coordenadas.lng}
                        nombre={clubEspecifico.nombre}
                        direccion={clubEspecifico.direccion}
                        zoom={15}
                        height="h-56 md:h-64"
                        markerColor="#1d3557"
                        client:load
                      />
                    </div>
                  </div>
                )}
              </div>

              <!-- Contacto y Horarios -->
              <div class="bg-background rounded-2xl p-5 border border-border/40">
                <h3 class="font-semibold text-lg mb-3 flex items-center gap-2 text-text">
                  <i class="fa-solid fa-user text-primary"></i>
                  Información de Contacto
                </h3>
                <p class="text-text font-semibold">
                  {clubEspecifico.fundador}
                </p>
                
                {clubEspecifico.email && (
                  <p class="text-text-muted text-sm mt-2 flex items-center gap-2">
                    <i class="fa-regular fa-envelope text-primary"></i>
                    <a
                      href={`mailto:${clubEspecifico.email}`}
                      class="hover:text-primary transition-colors"
                    >
                      {clubEspecifico.email}
                    </a>
                  </p>
                )}
                {clubEspecifico.telefono && (
                  <p class="text-text-muted text-sm mt-2 flex items-center gap-2">
                    <i class="fa-solid fa-phone text-primary"></i>
                    <a
                      href={`tel:${clubEspecifico.telefono}`}
                      class="hover:text-primary transition-colors"
                    >
                      {clubEspecifico.telefono}
                    </a>
                  </p>
                )}
                {clubEspecifico.horarios && (
                  <>
                    <h3 class="font-semibold text-lg mb-3 flex items-center gap-2 text-text mt-4">
                      <i class="fa-regular fa-clock text-primary"></i>
                      Horarios
                    </h3>
                    <p class="text-text-muted whitespace-pre-line text-sm">
                      {clubEspecifico.horarios || "Consultar directamente"}
                    </p>
                  </>
                )}
              </div>

              <!-- Entrenadores -->
              <div class="bg-background rounded-2xl p-5 border border-border/40">
                {clubEspecifico.entrenadores &&
                  clubEspecifico.entrenadores.length > 0 && (
                    <>
                      <h3 class="font-semibold text-lg mb-4 flex items-center gap-2 text-text">
                        <i class="fa-solid fa-users text-primary"></i>
                        Entrenadores
                      </h3>
                      <div class="grid grid-cols-1 gap-3">
                        {clubEspecifico.entrenadores.map((entrenador) => (
                          <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-surface-muted/30 transition-colors">
                            {entrenador.foto ? (
                              <img
                                src={entrenador.foto}
                                alt={entrenador.nombre}
                                class="w-14 h-14 rounded-2xl object-cover border-2 border-surface-muted shrink-0"
                                loading="lazy"
                              />
                            ) : (
                              <div class="w-14 h-14 rounded-2xl bg-surface-muted/60 flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-user text-xl text-primary"></i>
                              </div>
                            )}
                            <div class="min-w-0">
                              <p class="font-semibold text-text truncate">
                                {entrenador.nombre}
                              </p>
                              <p class="text-xs text-text-muted truncate">
                                {entrenador.especialidad}
                              </p>
                              {entrenador.experiencia && (
                                <p class="text-[11px] text-text-soft truncate">
                                  {entrenador.experiencia}
                                </p>
                              )}
                            </div>
                          </div>
                        ))}
                      </div>
                    </>
                )}
              </div>
            </div>

            <!-- Descripción -->
            {clubEspecifico.descripcion && (
              <div class="px-6 md:px-8 pb-6">
                <div class="bg-background rounded-2xl p-5 border border-border/40">
                  <h3 class="font-semibold text-lg mb-2 flex items-center gap-2 text-text">
                    <i class="fa-solid fa-circle-info text-primary"></i>
                    Sobre el Club
                  </h3>
                  <p class="text-text-muted leading-relaxed">
                    {clubEspecifico.descripcion}
                  </p>
                </div>
              </div>
            )}

            <!-- Galería -->
            {clubEspecifico.galeria && clubEspecifico.galeria.length > 0 && (
              <div class="px-6 md:px-8 pb-8">
                <h3 class="font-semibold text-xl mb-4 flex items-center gap-2 text-text">
                  <i class="fa-regular fa-image text-primary"></i>
                  Galería
                </h3>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                  {clubEspecifico.galeria.map((img, index) => (
                    <div class="rounded-2xl overflow-hidden border border-border/50 aspect-square bg-surface-muted/30 hover:scale-[1.02] transition-transform duration-300">
                      <img
                        src={img}
                        alt={`${clubEspecifico.nombre} - Imagen ${index + 1}`}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Botón de volver -->
            <div class="px-6 md:px-8 pb-6 flex justify-center">
              <a
                href={`/clubes/${estadoSlug}-${ciudadSlug}`}
                class="capitalize inline-flex items-center gap-2 text-primary bg-surface-muted/40 hover:bg-surface-muted px-4 py-2 rounded-xl transition-colors font-medium text-sm border border-border/40"
              >
                <i class="fa-solid fa-location-dot"></i>
                Ver más clubes en {ciudadSlug?.replace(/-/g, " ")}
              </a>
            </div>
          </div>
        </div>
      ) : null
    }

    <!-- CALL TO ACTION -->
    <div class="bg-surface-muted/30 border border-border rounded-3xl p-6 md:p-8 my-8 shadow-md shadow-primary/5">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="text-left">
          <h3 class="text-xl font-bold font-heading text-text flex items-center gap-2">
            <i class="fa-solid fa-star text-accent"></i>
            ¿No Está Tu Club Aquí?
          </h3>
          <p class="text-text-muted text-sm mt-1">
            Escríbenos para que tu club sea incluido en nuestra lista.
          </p>
        </div>
        <a 
          href="/contacto"
          class="inline-flex items-center gap-2 bg-accent text-text-inverse font-semibold px-8 py-3 rounded-xl hover:bg-accent-light hover:shadow-lg hover:shadow-accent/30 transition-all duration-200 whitespace-nowrap shadow-md shadow-accent/20"
        >
          <i class="fa-solid fa-briefcase"></i>
          Contáctanos
        </a>
      </div>
    </div>
  </div>
</Layout> 