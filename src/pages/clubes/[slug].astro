---
// src/pages/clubes/[slug].astro
import Layout from "../../layouts/LayoutBase.astro";
import { getTodosClubes } from "../../utils/dataLoader";
import estadosData from "../../data/estados.json";
import {
  FiMapPin,
  FiCalendar,
  FiUser,
  FiClock,
  FiHome,
  FiChevronRight,
  FiStar,
  FiInfo,
  FiExternalLink,
  FiMail,
  FiPhone,
  FiMap,
  FiAward,
  FiUsers,
  FiImage,
  FiBriefcase,
} from "react-icons/fi";
import { FaInstagram, FaWhatsapp } from "react-icons/fa";

// 🔥 COMPONENTE DE MAPA (OPCIONAL)
// Si prefieres no usar Leaflet, comenta esta importación
// y usa el mapa de Google Maps embed simple
import MapaClub from "../../components/MapaClub.jsx";

const ESTADOS = estadosData.estados || [];

// 🔥 Genera todas las rutas
export async function getStaticPaths() {
  const ESTADOS = estadosData.estados || [];
  const todosLosClubes = await getTodosClubes();
  const paths: any[] = [];

  ESTADOS.forEach((estado) => {
    paths.push({ params: { slug: estado.slug } });

    estado.ciudades.forEach((ciudad) => {
      const ciudadSlug = ciudad.toLowerCase().replace(/\s+/g, "-");
      paths.push({ params: { slug: `${estado.slug}-${ciudadSlug}` } });

      const clubesEnCiudad = todosLosClubes.filter((c) => {
        const cEstado = String(c.estado_slug || "").trim();
        const cCiudad = String(c.ciudad_slug || "").trim();
        return cEstado === estado.slug && cCiudad === ciudadSlug;
      });

      clubesEnCiudad.forEach((club) => {
        const clubSlug = String(club.slug || club.id || "").trim();
        if (clubSlug) {
          paths.push({
            params: { slug: `${estado.slug}-${ciudadSlug}-${clubSlug}` },
          });
        }
      });
    });
  });

  return paths;
}

const { slug } = Astro.params;
const todosLosClubes = await getTodosClubes();

let mostrarEstado = false;
let mostrarCiudad = false;
let mostrarClub = false;

let titulo = "";
let descripcion = "";
let clubesMostrar: any[] = [];
let clubEspecifico = null;
let estadoInfo = null;
let estadoSlug = "";
let ciudadSlug = "";
let ciudadNombre = "";

if (slug) {
  const slugStr = String(slug).trim();

  estadoInfo = ESTADOS.find((e) => e.slug === slugStr);

  if (estadoInfo) {
    mostrarEstado = true;
    estadoSlug = estadoInfo.slug;
    titulo = `Clubes de esgrima en ${estadoInfo.nombre}`;
    descripcion = `Encuentra los mejores clubes de esgrima en ${estadoInfo.nombre}.`;
    clubesMostrar = todosLosClubes.filter(
      (c) => String(c.estado_slug || "").trim() === estadoSlug,
    );
  } else {
    let estadoMatch = null;
    let ciudadMatch = "";

    for (const estado of ESTADOS) {
      for (const ciudad of estado.ciudades) {
        const ciudadSlugTest = ciudad.toLowerCase().replace(/\s+/g, "-");
        const testSlug = `${estado.slug}-${ciudadSlugTest}`;
        if (testSlug === slugStr) {
          estadoMatch = estado;
          ciudadMatch = ciudad;
          break;
        }
      }
      if (estadoMatch) break;
    }

    if (estadoMatch && ciudadMatch) {
      mostrarCiudad = true;
      estadoInfo = estadoMatch;
      estadoSlug = estadoMatch.slug;
      ciudadSlug = ciudadMatch.toLowerCase().replace(/\s+/g, "-");
      ciudadNombre = ciudadMatch;

      titulo = `Clubes de esgrima en ${ciudadMatch}, ${estadoMatch.nombre}`;
      descripcion = `Directorio de clubes de esgrima en ${ciudadMatch}, ${estadoMatch.nombre}.`;
      clubesMostrar = todosLosClubes.filter(
        (c) =>
          String(c.estado_slug || "").trim() === estadoSlug &&
          String(c.ciudad_slug || "").trim() === ciudadSlug,
      );
    } else {
      for (const club of todosLosClubes) {
        const clubSlugTest = String(club.slug || club.id || "").trim();
        if (slugStr.endsWith(clubSlugTest) && clubSlugTest) {
          const estadoTest = String(club.estado_slug || "").trim();
          const ciudadTest = String(club.ciudad_slug || "").trim();
          const testSlug = `${estadoTest}-${ciudadTest}-${clubSlugTest}`;

          if (testSlug === slugStr) {
            mostrarClub = true;
            clubEspecifico = club;
            estadoSlug = estadoTest;
            ciudadSlug = ciudadTest;
            estadoInfo = ESTADOS.find((e) => e.slug === estadoTest);

            titulo = `${club.nombre} - Club de esgrima en ${club.ciudad}`;
            descripcion =
              club.descripcion ||
              `Club de esgrima ${club.especialidad} en ${club.ciudad}, ${club.estado}.`;
            break;
          }
        }
      }
    }
  }
}

// 🔥 FUNCIÓN PARA GENERAR URL DE MAPA ESTÁTICO (Google Maps embed)
function getGoogleMapsUrl(lat, lng, nombre) {
  return `https://www.google.com/maps/embed/v1/place?key=YOUR_GOOGLE_MAPS_API_KEY&q=${lat},${lng}&zoom=15`;
}

// 🔥 FUNCIÓN PARA LINK DE WAZE/GOOGLE MAPS
function getMapsLink(lat, lng) {
  return `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
}
---

<Layout title={titulo || "Página no encontrada"} description={descripcion}>
  <div class="container mx-auto px-4 py-8">
    {
      !mostrarEstado && !mostrarCiudad && !mostrarClub ? (
        // --- ERROR ---
        <div class="bg-white rounded-xl shadow-md p-8 text-center">
          <FiMapPin className="w-12 h-12 mx-auto text-gray-300 mb-4" />
          <h1 class="text-2xl font-bold mb-2">Página no encontrada</h1>
          <p class="text-gray-500">No se encontró la página solicitada.</p>
          <a
            href="/clubes"
            class="text-primary hover:underline mt-4 inline-block"
          >
            Volver al directorio
          </a>
        </div>
      ) : mostrarEstado ? (
        // --- VISTA DE ESTADO (sin cambios) ---
        <div>
          <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8 flex-wrap">
            <a href="/" class="hover:text-primary transition-colors">
              <FiHome className="w-4 h-4 inline" />
              <span class="ml-1">Inicio</span>
            </a>
            <FiChevronRight className="w-4 h-4 text-gray-300" />
            <a href="/clubes" class="hover:text-primary transition-colors">
              Clubes
            </a>
            <FiChevronRight className="w-4 h-4 text-gray-300" />
            <span class="text-primary font-medium">
              {estadoInfo?.nombre || estadoSlug}
            </span>
          </nav>

          <div class="bg-linear-to-r from-primary to-primary-light text-white rounded-2xl p-8 mb-8">
            <h1 class="text-3xl md:text-4xl font-bold font-heading mb-2">
              {titulo}
            </h1>
            <p class="text-gray-300 text-lg">{descripcion}</p>
          </div>

          {estadoInfo?.ciudades && estadoInfo.ciudades.length > 0 && (
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mb-8">
              {estadoInfo.ciudades.map((ciudad) => {
                const ciudadSlugMap = ciudad.toLowerCase().replace(/\s+/g, "-");
                const clubesEnCiudad = todosLosClubes.filter(
                  (c) =>
                    String(c.estado_slug || "").trim() === estadoSlug &&
                    String(c.ciudad_slug || "").trim() === ciudadSlugMap,
                );
                return (
                  <a
                    href={`/clubes/${estadoSlug}-${ciudadSlugMap}`}
                    class="bg-white rounded-xl shadow-md p-4 hover:shadow-lg hover:-translate-y-1 transition-all duration-200 border border-gray-100 text-center group"
                  >
                  <div class="w-16 h-16 mx-auto bg-indigo-100 rounded-full flex items-center justify-center mb-3 group-hover:bg-indigo-500 transition-colors">
                    <FiMapPin className="w-8 h-8 text-primary group-hover:text-gold transition-colors" />
                  </div>
                    <h3 class="font-semibold text-primary group-hover:text-gold transition-colors">
                      {ciudad}
                    </h3>
                    <p class="text-sm text-gray-500 mt-1"> 
                      {clubesEnCiudad.length} clubes
                    </p>
                  </a>
                );
              })}
            </div>
          )}

          <h2 class="text-2xl font-bold font-heading mb-6">Todos los clubes</h2>
          {clubesMostrar.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {clubesMostrar.map((club) => {
                const clubSlugMap = String(club.slug || club.id || "").trim();
                const ciudadSlugMap = String(club.ciudad_slug || "").trim();
                return (
                  <a
                    href={`/clubes/${estadoSlug}-${ciudadSlugMap}-${clubSlugMap}`}
                    class="bg-white rounded-xl shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300 border border-gray-100 group overflow-hidden"
                  >
                    {club.imagen_portada && (
                      <div class="h-32 bg-gray-200 overflow-hidden">
                        <img
                          src={club.imagen_portada}
                          alt={club.nombre}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="p-6">
                      <div class="flex items-start justify-between">
                        <div class="flex items-center gap-3">
                          {club.logo && (
                            <img
                              src={club.logo}
                              alt={club.nombre}
                              class="w-12 h-12 rounded-full object-cover border-2 border-gray-200"
                              loading="lazy"
                            />
                          )}
                          <h3 class="text-xl font-bold text-primary group-hover:text-gold transition-colors line-clamp-2">
                            {club.nombre}
                          </h3>
                        </div>
                        {club.destacado && (
                          <span class="flex items-center gap-1 text-xs bg-gold/20 text-gold-dark px-2 py-1 rounded-full font-semibold whitespace-nowrap ml-2">
                            <FiStar className="w-3 h-3" />
                            Destacado
                          </span>
                        )}
                      </div>
                      <p class="text-gray-500 text-sm mt-1 flex items-center gap-1">
                        <FiMapPin className="w-3 h-3" />
                        {club.ciudad}
                      </p>
                      <div class="flex flex-wrap gap-2 mt-4">
                        <span class="text-xs bg-primary/10 text-primary px-3 py-1 rounded-full">
                          {club.especialidad}
                        </span>
                        <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full flex items-center gap-1">
                          <FiCalendar className="w-3 h-3" />
                          {club.edades}
                        </span>
                        {club.entrenadores && (
                          <span class="text-xs bg-blue-50 text-blue-600 px-3 py-1 rounded-full flex items-center gap-1">
                            <FiUsers className="w-3 h-3" />
                            {club.entrenadores.length} entrenadores
                          </span>
                        )}
                      </div>
                      {club.descripcion && (
                        <p class="text-sm text-gray-600 mt-3 line-clamp-2">
                          {club.descripcion}
                        </p>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          ) : (
            <div class="bg-white rounded-xl shadow-md p-12 text-center border-2 border-dashed border-gray-200">
              <FiMapPin className="w-16 h-16 mx-auto text-gray-300 mb-4" />
              <p class="text-gray-500">
                No hay clubes registrados en este estado aún.
              </p>
            </div>
          )}
        </div>
      ) : mostrarCiudad ? (
        // --- VISTA DE CIUDAD (sin cambios) ---
        <div>
          <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8 flex-wrap">
            <a href="/" class="hover:text-primary transition-colors">
              <FiHome className="w-4 h-4 inline" />
              <span class="ml-1">Inicio</span>
            </a>
            <FiChevronRight className="w-4 h-4 text-gray-300" />
            <a href="/clubes" class="hover:text-primary transition-colors">
              Clubes
            </a>
            <FiChevronRight className="w-4 h-4 text-gray-300" />
            <a
              href={`/clubes/${estadoSlug}`}
              class="hover:text-primary transition-colors"
            >
              {estadoInfo?.nombre}
            </a>
            <FiChevronRight className="w-4 h-4 text-gray-300" />
            <span class="text-primary font-medium">{ciudadNombre}</span>
          </nav>

          <div class="bg-linear-to-r from-primary to-primary-light text-white rounded-2xl p-8 mb-8">
            <h1 class="text-3xl md:text-4xl font-bold font-heading mb-2">
              {titulo}
            </h1>
            <p class="text-gray-300 text-lg">{descripcion}</p>
          </div>

          {clubesMostrar.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {clubesMostrar.map((club) => {
                const clubSlugMap = String(club.slug || club.id || "").trim();
                return (
                  <a
                    href={`/clubes/${estadoSlug}-${ciudadSlug}-${clubSlugMap}`}
                    class="bg-white rounded-xl shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300 border border-gray-100 group overflow-hidden"
                  >
                    {club.imagen_portada && (
                      <div class="h-32 bg-gray-200 overflow-hidden">
                        <img
                          src={club.imagen_portada}
                          alt={club.nombre}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="p-6">
                      <div class="flex items-start justify-between">
                        <div class="flex items-center gap-3">
                          {club.logo && (
                            <img
                              src={club.logo}
                              alt={club.nombre}
                              class="w-12 h-12 rounded-full object-cover border-2 border-gray-200"
                              loading="lazy"
                            />
                          )}
                          <h3 class="text-xl font-bold text-primary group-hover:text-gold transition-colors">
                            {club.nombre}
                          </h3>
                        </div>
                        {club.destacado && (
                          <span class="flex items-center gap-1 text-xs bg-gold/20 text-gold-dark px-2 py-1 rounded-full font-semibold">
                            <FiStar className="w-3 h-3" />
                            Destacado
                          </span>
                        )}
                      </div>
                      <div class="flex flex-wrap gap-2 mt-4">
                        <span class="text-xs bg-primary/10 text-primary px-3 py-1 rounded-full">
                          {club.especialidad}
                        </span>
                        <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full flex items-center gap-1">
                          <FiCalendar className="w-3 h-3" />
                          {club.edades}
                        </span>
                      </div>
                      {club.descripcion && (
                        <p class="text-sm text-gray-600 mt-3 line-clamp-2">
                          {club.descripcion}
                        </p>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          ) : (
            <div class="bg-white rounded-xl shadow-md p-12 text-center border-2 border-dashed border-gray-200">
              <FiMapPin className="w-16 h-16 mx-auto text-gray-300 mb-4" />
              <p class="text-gray-500">
                No hay clubes registrados en esta ciudad aún.
              </p>
            </div>
          )}
        </div>
      ) : mostrarClub && clubEspecifico ? (
        // --- VISTA DE CLUB (DETALLADA CON TODOS LOS CAMPOS) ---
        <div>
          <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8 flex-wrap">
            <a href="/" class="hover:text-primary transition-colors">
              <FiHome className="w-4 h-4 inline" />
              <span class="ml-1">Inicio</span>
            </a>
            <FiChevronRight className="w-4 h-4 text-gray-300" />
            <a href="/clubes" class="hover:text-primary transition-colors">
              Clubes
            </a>
            <FiChevronRight className="w-4 h-4 text-gray-300" />
            <a
              href={`/clubes/${estadoSlug}`}
              class="hover:text-primary transition-colors"
            >
              {estadoInfo?.nombre}
            </a>
            <FiChevronRight className="w-4 h-4 text-gray-300" />
            <a
              href={`/clubes/${estadoSlug}-${ciudadSlug}`}
              class="hover:text-primary transition-colors"
            >
              {ciudadSlug?.replace(/-/g, " ")}
            </a>
            <FiChevronRight className="w-4 h-4 text-gray-300" />
            <span class="text-primary font-medium">
              {clubEspecifico.nombre}
            </span>
          </nav>

          <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
            {/* Imagen de Portada */}
            {clubEspecifico.imagen_portada && (
              <div class="w-full h-64 md:h-80 bg-gray-200 overflow-hidden">
                <img
                  src={clubEspecifico.imagen_portada}
                  alt={clubEspecifico.nombre}
                  class="w-full h-full object-cover"
                />
              </div>
            )}

            {/* Header del Club */}
            <div class="p-6 md:p-8">
              <div class="flex flex-col md:flex-row md:items-center gap-6">
                {clubEspecifico.logo && (
                  <img
                    src={clubEspecifico.logo}
                    alt={clubEspecifico.nombre}
                    class="w-24 h-24 rounded-full object-cover border-4 border-gray-100 shrink-0"
                    loading="lazy"
                  />
                )}
                <div class="flex-1">
                  <div class="flex items-center gap-3 flex-wrap">
                    <h1 class="text-3xl md:text-4xl font-bold font-heading">
                      {clubEspecifico.nombre}
                    </h1>
                    {clubEspecifico.destacado && (
                      <span class="flex items-center gap-1 text-sm bg-gold/20 text-gold-dark px-3 py-1 rounded-full font-semibold">
                        <FiStar className="w-4 h-4" />
                        Destacado
                      </span>
                    )}
                  </div>
                  <div class="flex flex-wrap gap-2 mt-2">
                    <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-sm flex items-center gap-1">
                      <FiMapPin className="w-3 h-3" />
                      {clubEspecifico.especialidad}
                    </span>
                    <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm flex items-center gap-1">
                      <FiMapPin className="w-3 h-3" />
                      {clubEspecifico.ciudad}, {clubEspecifico.estado}
                    </span>
                    <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm flex items-center gap-1">
                      <FiCalendar className="w-3 h-3" />
                      {clubEspecifico.edades}
                    </span>
                  </div>
                </div>
                <div class="flex flex-wrap gap-2">
                  {clubEspecifico.instagram && (
                    <a
                      href={clubEspecifico.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 px-4 py-2 bg-pink-600 text-white rounded-lg hover:bg-pink-700 transition text-sm"
                    >
                      <FaInstagram className="w-4 h-4" />
                      Instagram
                    </a>
                  )}
                  {clubEspecifico.whatsapp && (
                    <a
                      href={clubEspecifico.whatsapp}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-sm"
                    >
                      <FaWhatsapp className="w-4 h-4" />
                      WhatsApp
                    </a>
                  )}
                  {clubEspecifico.web && (
                    <a
                      href={clubEspecifico.web}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition text-sm"
                    >
                      <FiExternalLink className="w-4 h-4" />
                      Web
                    </a>
                  )}
                </div>
              </div>
            </div>

            {/* Información Principal */}
            <div class="px-6 md:px-8 pb-6 grid grid-cols-1 md:grid-cols-3 gap-6">
              <div class="bg-gray-50 rounded-xl p-5">
                <h3 class="font-semibold text-lg mb-3 flex items-center gap-2 text-primary">
                  <FiMapPin className="w-5 h-5" />
                  Ubicación
                </h3>
                <p class="text-gray-600">{clubEspecifico.direccion}</p>
                {clubEspecifico.direccion_alternativa && (
                  <p class="text-gray-600 text-sm mt-1">
                    {clubEspecifico.direccion_alternativa}
                  </p>
                )}
                {clubEspecifico.coordenadas && (
                  <div class="mt-3">
                    <a
                      href={getMapsLink(
                        clubEspecifico.coordenadas.lat,
                        clubEspecifico.coordenadas.lng,
                      )}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary font-bold text-sm flex items-center gap-1 bg-amber-500 px-3 py-2 rounded-lg transition hover:bg-amber-600 "
                    >
                      <FiMap className="w-4 h-4" />
                      Cómo llegar
                    </a>

                    <div class="mt-3">
                      <MapaClub
                        lat={clubEspecifico.coordenadas.lat}
                        lng={clubEspecifico.coordenadas.lng}
                        nombre={clubEspecifico.nombre}
                        direccion={clubEspecifico.direccion}
                        zoom={15}
                        height="h-56 md:h-64"
                        markerColor="#1a1a2e"
                        client:load
                      />
                    </div>
                  </div>
                )}
              </div>

              <div class="bg-gray-50 rounded-xl p-5">
                <h3 class="font-semibold text-lg mb-3 flex items-center gap-2 text-primary">
                  <FiUser className="w-5 h-5" />
                  Información de Contacto
                </h3>
                <p class="text-gray-600 font-semibold">
                  {clubEspecifico.fundador}
                </p>
                
                {clubEspecifico.email && (
                  <p class="text-gray-600 text-sm mt-2 flex items-center gap-1">
                    <FiMail className="w-4 h-4 text-primary" />
                    <a
                      href={`mailto:${clubEspecifico.email}`}
                      class="hover:text-primary"
                    >
                      {clubEspecifico.email}
                    </a>
                  </p>
                )}
                {clubEspecifico.telefono && (
                  <p class="text-gray-600 text-sm mt-1 flex items-center gap-1">
                    <FiPhone className="w-4 h-4 text-primary" />
                    <a
                      href={`tel:${clubEspecifico.telefono}`}
                      class="hover:text-primary"
                    >
                      {clubEspecifico.telefono}
                    </a>
                  </p>
                )}
                {clubEspecifico.horarios && (
                   
                    <h3 class="font-semibold text-lg mb-3 flex items-center gap-2 text-primary mt-4">
                      <FiClock className="w-5 h-5" />
                      Horarios
                    </h3>
                    <p class="text-gray-600 whitespace-pre-line">
                      {clubEspecifico.horarios || "Consultar directamente"}
                    </p>
                   
                )}
              </div>

              <div class="bg-gray-50 rounded-xl p-5">
                    {/* Entrenadores */}
            {clubEspecifico.entrenadores &&
              clubEspecifico.entrenadores.length > 0 && (                 
                  <h3 class="font-semibold text-xl mb-4 flex items-center gap-2 text-primary">
                    <FiUsers className="w-5 h-5" />
                    Entrenadores
                  </h3>
                  <div class="grid grid-cols-1  gap-4">
                    {clubEspecifico.entrenadores.map((entrenador) => (
                      <div
                        
                        class="bg-gray-50 rounded-xl flex items-center gap-4"
                      >
                        {entrenador.foto ? (
                          <img
                            src={entrenador.foto}
                            alt={entrenador.nombre}
                            class="w-16 h-16 rounded-full object-cover border-2 border-gray-200"
                            loading="lazy"
                          />
                        ) : (
                          <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center text-2xl">
                            <FiUser className="w-8 h-8 text-primary" />
                          </div>
                        )}
                        <div>
                          <p class="font-semibold text-gray-800">
                            {entrenador.nombre}
                          </p>
                          <p class="text-sm text-gray-600">
                            {entrenador.especialidad}
                          </p>
                          {entrenador.experiencia && (
                            <p class="text-xs text-gray-400">
                              {entrenador.experiencia}
                            </p>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                
              )}
              </div>
            </div>           

            {/* Descripción */}
            {clubEspecifico.descripcion && (
              <div class="px-6 md:px-8 pb-6">
                <div class="bg-gray-50 rounded-xl p-5">
                  <h3 class="font-semibold text-lg mb-2 flex items-center gap-2 text-primary">
                    <FiInfo className="w-5 h-5" />
                    Sobre el Club
                  </h3>
                  <p class="text-gray-700 leading-relaxed">
                    {clubEspecifico.descripcion}
                  </p>
                </div>
              </div>
            )}

            {/* Galería de Imágenes */}
            {clubEspecifico.galeria && clubEspecifico.galeria.length > 0 && (
              <div class="px-6 md:px-8 pb-8">
                <h3 class="font-semibold text-xl mb-4 flex items-center gap-2 text-primary">
                  <FiImage className="w-5 h-5" />
                  Galería
                </h3>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                  {clubEspecifico.galeria.map((img, index) => (
                    <div
                       
                      class="rounded-lg overflow-hidden border border-gray-200 aspect-square bg-gray-100 hover:scale-105 transition-transform duration-300"
                    >
                      <img
                        src={img}
                        alt={`${clubEspecifico.nombre} - Imagen ${index + 1}`}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Botón de volver */}
            <div class="px-6 md:px-8 pb-6 flex justify-center">
              <a
                href={`/clubes/${estadoSlug}-${ciudadSlug}`}
                class="text-primary capitalize flex items-center gap-2 bg-gold/10 px-4 py-2 rounded-lg transition hover:bg-amber-300"
              >
                <FiMapPin className="w-4 h-4" />
                Ver más clubes en {ciudadSlug?.replace(/-/g, " ")}
              </a>
            </div>
          </div>
        </div>
      ) : null
    }
    <!-- CALL TO ACTION - Contrata publicidad -->
    <div class="bg-gold/10 border-2 border-gold rounded-2xl p-6 md:p-8 my-8 text-center">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="text-left">
          <h3 class="text-xl font-bold font-heading text-primary flex items-center gap-2">
            <FiStar className="w-6 h-6 text-gold" />
            ¿No Esta Tu Club Aquí?
          </h3>
          <p class="text-gray-600 text-sm mt-1">
            Escribenos para que tu club sea incluido en nuestra lista.
          </p>
        </div>
        <a 
          href="/contacto"
          class="bg-gold text-primary font-semibold px-8 py-3 rounded-xl hover:bg-gold-light hover:shadow-lg transition-all duration-200 whitespace-nowrap flex items-center gap-2"
        >
          <FiBriefcase className="w-4 h-4" />
          Contactanos
        </a>
      </div>
    </div>
  </div>
    
</Layout>
