<Layout title={guia.titulo} description={guia.descripcion}>
  <div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8 flex-wrap">
      <a href="/" class="hover:text-primary transition-colors">
        <FiHome className="w-4 h-4 inline" />
        <span class="ml-1">Inicio</span>
      </a>
      <FiChevronRight className="w-4 h-4 text-gray-300" />
      <a href="/guias" class="hover:text-primary transition-colors">Guías</a>
      <FiChevronRight className="w-4 h-4 text-gray-300" />
      <span class="text-primary font-medium">Zapatillas</span>
    </nav>

    <!-- Hero -->
    <div class="bg-linear-to-r from-primary to-primary-light text-white rounded-2xl p-8 mb-8">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-2 text-sm text-gold mb-2">
            <FiStar className="w-4 h-4" />
            <span>Guía de Compra</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-bold font-heading mb-2">
            {guia.titulo}
          </h1>
          <p class="text-gray-300 text-lg max-w-2xl">
            {guia.descripcion}
          </p>
          <div class="flex items-center gap-4 mt-4 text-sm text-gray-400">
            <span><i class="fa-regular fa-calendar"></i> {guia.fecha}</span>
            <span>•</span>
            <span><i class="fa-regular fa-user"></i> {guia.autor}</span>
          </div>
        </div>
        <div class="shrink-0">
           <div class="p-6 text-center">
            <img 
                  src="/images/guias/zapatos.jpg"
                  alt="Zapatos de Esgrima"
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 rounded-2xl"
                  loading="lazy"
                />          
          </div>
        </div>
      </div>
    </div>

    <!-- 📋 Índice Rápido -->
    <div class="bg-gray-50 rounded-2xl p-6 mb-8 border border-gray-200">
      <h2 class="text-sm font-semibold text-gray-600 mb-3">En esta guía:</h2>
      <div class="flex flex-wrap gap-3">
        <a href="#tipos" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Tipos de zapatillas</a>
        <a href="#caracteristicas" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Características clave</a>
        <a href="#marcas" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Marcas destacadas</a>
        <a href="#modelos" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Modelos populares</a>
        <a href="#comparativa" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Comparativa</a>
        <a href="#recomendacion" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">¿Cuál elegir?</a>
      </div>
    </div>

    <!-- 🎯 ¿Por qué necesitas zapatillas de esgrima? -->
    <section class="bg-white rounded-2xl shadow-md p-6 md:p-8 mb-8 border border-gray-100">
      <h2 class="text-2xl font-bold font-heading mb-4">¿Por qué necesitas zapatillas específicas para esgrima?</h2>
      <p class="text-gray-700 leading-relaxed mb-4">
        La esgrima es un deporte de explosividad, precisión y movimientos laterales rápidos. Cada estocada, cambio de dirección y recuperación somete a tus pies, tobillos, rodillas y caderas a un estrés intenso. Las zapatillas de esgrima están diseñadas específicamente para absorber estos impactos y proporcionar la estabilidad necesaria para movimientos rápidos y precisos.
      </p>
      <p class="text-gray-700 leading-relaxed">
        Usar calzado inapropiado, como zapatillas de running o tenis, puede aumentar el riesgo de lesiones como esguinces de tobillo, dolor de rodillas, tendinitis aquílea y dolor lumbar. Las zapatillas de running están diseñadas para movimiento hacia adelante, no para los movimientos laterales y explosivos de la esgrima, por lo que no proporcionan el soporte y la estabilidad necesarios.
      </p>
    </section>

    <!-- 👟 Tipos de Zapatillas -->
    <section id="tipos" class="bg-white rounded-2xl shadow-md p-6 md:p-8 mb-8 border border-gray-100">
      <h2 class="text-2xl font-bold font-heading mb-4">Tipos de Zapatillas de Esgrima</h2>
      <p class="text-gray-600 mb-6">Cada tipo de zapatilla está diseñado para un perfil de esgrimista diferente. Elige el que mejor se adapte a tu nivel y necesidades.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {tipos.map((tipo) => (
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 hover:border-primary transition">
            <i class={`${tipo.icono} text-4xl text-primary mb-3`}></i>
            <h3 class="text-xl font-bold font-heading text-primary">{tipo.nombre}</h3>
            <p class="text-sm text-gray-600 mt-2">{tipo.descripcion}</p>
            <div class="mt-3">
              {tipo.ventajas.map((ventaja) => (
                <span class="inline-block text-xs bg-green-50 text-green-700 px-2 py-1 rounded-full mr-1 mb-1">
                  <i class="fa-solid fa-check text-green-500 mr-1"></i>
                  {ventaja}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 🔑 Características Clave -->
    <section id="caracteristicas" class="bg-white rounded-2xl shadow-md p-6 md:p-8 mb-8 border border-gray-100">
      <h2 class="text-2xl font-bold font-heading mb-4">Características Clave</h2>
      <p class="text-gray-600 mb-6">Estos son los aspectos más importantes que debes considerar al elegir tus zapatillas de esgrima.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {caracteristicas.map((carac) => (
          <div class="bg-gray-50 rounded-xl p-5 border border-gray-200 hover:shadow-md transition">
            <div class="flex items-center gap-3 mb-2">
              <i class={`${carac.icono} text-2xl text-primary`}></i>
              <h3 class="font-bold text-primary">{carac.nombre}</h3>
            </div>
            <p class="text-sm text-gray-600">{carac.descripcion}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 🏷️ Marcas Destacadas -->
    <section id="marcas" class="bg-white rounded-2xl shadow-md p-6 md:p-8 mb-8 border border-gray-100">
      <h2 class="text-2xl font-bold font-heading mb-4">Marcas Destacadas</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {marcas.map((marca) => (
          <div class="bg-gray-50 rounded-xl p-2 border border-gray-200 hover:border-primary transition">
            <div class="flex items-center gap-3">
                <img 
                  src={marca.icono} 
                  alt={marca.nombre}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              <div>
                <h3 class="font-bold text-primary">{marca.nombre}</h3>
                <p class="text-sm text-gray-600">{marca.descripcion}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 📸 Modelos Populares CON IMÁGENES PEQUEÑAS -->
    <section id="modelos" class="bg-white rounded-2xl shadow-md p-6 md:p-8 mb-8 border border-gray-100">
      <h2 class="text-2xl font-bold font-heading mb-4">
        <i class="fa-solid fa-fire text-gold mr-2"></i>
        Modelos Populares
      </h2>
      <p class="text-gray-600 mb-6">Los modelos más buscados y recomendados del mercado.</p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {modelosPopulares.map((modelo) => (
          <div class="bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-primary hover:shadow-md transition text-center group">
            {modelo.imagen ? (
              <div class="relative overflow-hidden rounded-lg mb-2">
                <img 
                  src={modelo.imagen} 
                  alt={modelo.nombre} 
                  class="w-full h-24 object-cover rounded-lg group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute top-1 right-1 text-[10px] bg-primary/80 text-white px-1.5 py-0.5 rounded-full">
                  {modelo.pais}
                </div>
              </div>
            ) : (
              <div class="w-full h-24 bg-gray-200 rounded-lg flex items-center justify-center text-2xl mb-2">👟</div>
            )}
            <p class="text-xs font-semibold text-primary line-clamp-1">{modelo.nombre}</p>
            <p class="text-[10px] text-gray-400">{modelo.marca}</p>
            <span class="inline-block text-[10px] bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded-full mt-1">
              {modelo.tipo}
            </span>
          </div>
        ))}
      </div>
      <div class="mt-4 text-xs text-gray-400 text-center">
        <i class="fa-solid fa-info-circle mr-1"></i>
        Esta lista puede variar semanalmente.
      </div>
    </section>

    <!-- 📊 Comparativa de Modelos - UNA COLUMNA, 4 FILAS -->
    <section id="comparativa" class="bg-white rounded-2xl shadow-md p-6 md:p-8 mb-8 border border-gray-100">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <h2 class="text-2xl font-bold font-heading">Comparativa de Modelos</h2>
        <span class="bg-gold/20 text-gold-dark text-xs px-3 py-1 rounded-full font-semibold">Top 4</span>
        <span class="bg-green-50 text-green-600 text-xs px-3 py-1 rounded-full font-semibold">
          <i class="fa-solid fa-flag mr-1"></i>
          Mejores diseños
        </span>
      </div>
      <p class="text-gray-600 mb-6">Compara las características clave de los modelos más destacados del mercado, incluyendo opciones de diferentes regiones.</p>

      <!-- 🔥 UNA COLUMNA, 4 FILAS -->
      <div class="space-y-6">
        {comparativa.map((modelo, index) => (
          <div class={`bg-gray-50 rounded-xl p-6 border-2 transition hover:shadow-lg ${
            modelo.destacado ? 'border-gold shadow-md' : 'border-gray-200 hover:border-primary'
          }`}>
            <div class="flex flex-col md:flex-row md:items-start gap-6">
              <!-- Columna Izquierda: Imagen -->
              <div class="md:w-64 shrink-0">
                {modelo.destacado && (
                  <div class="bg-gold text-primary text-xs font-bold px-3 py-1 rounded-full inline-block mb-3">
                    <i class="fa-solid fa-star mr-1"></i>
                    Top Pick
