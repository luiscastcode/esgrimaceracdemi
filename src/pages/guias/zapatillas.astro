<!-- 🔥 LIGHTBOX JAVASCRIPT -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 🔹 Crear el lightbox
    const lightbox = document.createElement('div');
    lightbox.id = 'lightbox-overlay';
    lightbox.className = 'fixed inset-0 z-[999] bg-primary/95 hidden items-center justify-center p-4';
    lightbox.innerHTML = `
      <div class="relative max-w-4xl w-full">
        <button id="lightbox-close" class="absolute -top-12 right-0 text-text-inverse text-3xl hover:text-accent transition" aria-label="Cerrar">
          <i class="fa-solid fa-xmark"></i>
        </button>
        <img id="lightbox-image" src="" alt="" class="w-full h-auto rounded-2xl max-h-[80vh] object-contain" />
        <div id="lightbox-caption" class="text-text-inverse text-center mt-4 text-lg font-semibold"></div>
        <div id="lightbox-subcaption" class="text-surface-muted text-center text-sm"></div>
      </div>
    `;
    document.body.appendChild(lightbox);

    // 🔹 Capturar referencias con tipado correcto
    const overlay = document.getElementById('lightbox-overlay');
    const image = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const caption = document.getElementById('lightbox-caption');
    const subcaption = document.getElementById('lightbox-subcaption');
    const closeBtn = document.getElementById('lightbox-close');

    // ✅ Salida temprana: si algo falta, no seguimos
    if (!overlay || !image || !caption || !subcaption || !closeBtn) return;

    // 🔹 Función para cerrar
    function closeLightbox() {
      overlay!.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // 🔹 Función para abrir
    function openLightbox(src: string, alt: string, title: string, subtitle: string) {
      image!.src = src;
      image!.alt = alt;
      caption!.textContent = title;
      subcaption!.textContent = subtitle;
      overlay!.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    // 🔹 Event listeners básicos
    closeBtn.addEventListener('click', closeLightbox);

    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeLightbox();
      }
    });

    // 🔹 Asignar eventos a las imágenes con lightbox
    const triggers = document.querySelectorAll<HTMLElement>('[data-lightbox-id]');

    triggers.forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        const imgSrc = trigger.dataset.lightboxImg;
        const name = trigger.dataset.lightboxName;
        const marca = trigger.dataset.lightboxMarca;
        const tipo = trigger.dataset.lightboxTipo;

        if (!imgSrc) return;

        const subtitle = [marca, tipo].filter(Boolean).join(' - ');
        openLightbox(imgSrc, name || 'Producto', name || 'Producto', subtitle);
      });
    });
  });
</script>