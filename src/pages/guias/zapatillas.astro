---
 <Layout title={guia.titulo} description={guia.descripcion}>
  <div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-text-muted mb-8 flex-wrap">
      <a href="/" class="hover:text-primary transition-colors inline-flex items-center gap-1">
        <i class="fa-solid fa-house text-xs"></i>
        <span>Inicio</span>
      </a>
      <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
      <a href="/guias" class="hover:text-primary transition-colors">Guías</a>
      <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
      <span class="text-primary font-medium">Zapatillas</span>
    </nav>

    <!-- Hero -->
    <div class="bg-linear-to-r from-primary to-primary-light text-text-inverse rounded-3xl p-8 mb-8 shadow-lg shadow-primary/10">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-2 text-sm text-accent mb-2">
            <i class="fa-solid fa-star text-xs"></i>
            <span>Guía de Compra</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-bold font-heading mb-2">
            {guia.titulo}
          </h1>
          <p class="text-surface-muted text-lg max-w-2xl">
            {guia.descripcion}
          </p>
          <div class="flex items-center gap-4 mt-4 text-sm text-surface-muted/80">
            <span><i class="fa-regular fa-calendar mr-1"></i> {guia.fecha}</span>
            <span>•</span>
            <span><i class="fa-regular fa-user mr-1"></i> {guia.autor}</span>
          </div>
        </div>
        <div class="shrink-0">
          <div class="p-6 text-center">
            <img 
              src="/images/guias/zapatos.jpg"
              alt="Zapatos de Esgrima"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 rounded-2xl"
              loading="lazy"
            />          
          </div>
        </div>
      </div>
    </div>

    <!-- 📋 Índice Rápido -->
    <div class="bg-surface-muted/30 rounded-3xl p-6 mb-8 border border-border/50">
      <h2 class="text-sm font-semibold text-text-muted mb-3">En esta guía:</h2>
      <div class="flex flex-wrap gap-3">
        <a href="#tipos" class="text-sm bg-surface text-text px-4 py-2 rounded-full hover:bg-primary hover:text-text-inverse transition border border-border/60">Tipos de zapatillas</a>
        <a href="#caracteristicas" class="text-sm bg-surface text-text px-4 py-2 rounded-full hover:bg-primary hover:text-text-inverse transition border border-border/60">Características clave</a>
        <a href="#marcas" class="text-sm bg-surface text-text px-4 py-2 rounded-full hover:bg-primary hover:text-text-inverse transition border border-border/60">Marcas destacadas</a>
        <a href="#modelos" class="text-sm bg-surface text-text px-4 py-2 rounded-full hover:bg-primary hover:text-text-inverse transition border border-border/60">Modelos populares</a>
        <a href="#comparativa" class="text-sm bg-surface text-text px-4 py-2 rounded-full hover:bg-primary hover:text-text-inverse transition border border-border/60">Comparativa</a>
        <a href="#recomendacion" class="text-sm bg-surface text-text px-4 py-2 rounded-full hover:bg-primary hover:text-text-inverse transition border border-border/60">¿Cuál elegir?</a>
      </div>
    </div>

    <!-- 🎯 ¿Por qué necesitas zapatillas de esgrima? -->
    <section class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-6 md:p-8 mb-8 border border-border/50">
      <h2 class="text-2xl font-bold font-heading mb-4 text-text">¿Por qué necesitas zapatillas específicas para esgrima?</h2>
      <p class="text-text-muted leading-relaxed mb-4">
        La esgrima es un deporte de explosividad, precisión y movimientos laterales rápidos. Cada estocada, cambio de dirección y recuperación somete a tus pies, tobillos, rodillas y caderas a un estrés intenso. Las zapatillas de esgrima están diseñadas específicamente para absorber estos impactos y proporcionar la estabilidad necesaria para movimientos rápidos y precisos.
      </p>
      <p class="text-text-muted leading-relaxed">
        Usar calzado inapropiado, como zapatillas de running o tenis, puede aumentar el riesgo de lesiones como esguinces de tobillo, dolor de rodillas, tendinitis aquílea y dolor lumbar. Las zapatillas de running están diseñadas para movimiento hacia adelante, no para los movimientos laterales y explosivos de la esgrima, por lo que no proporcionan el soporte y la estabilidad necesarios.
      </p>
    </section>

    <!-- 👟 Tipos de Zapatillas -->
    <section id="tipos" class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-6 md:p-8 mb-8 border border-border/50">
      <h2 class="text-2xl font-bold font-heading mb-4 text-text">Tipos de Zapatillas de Esgrima</h2>
      <p class="text-text-muted mb-6">Cada tipo de zapatilla está diseñado para un perfil de esgrimista diferente. Elige el que mejor se adapte a tu nivel y necesidades.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {tipos.map((tipo) => (
          <div class="bg-background rounded-2xl p-6 border border-border/40 hover:border-border transition">
            <i class={`${tipo.icono} text-4xl text-primary mb-3`}></i>
            <h3 class="text-xl font-bold font-heading text-text">{tipo.nombre}</h3>
            <p class="text-sm text-text-muted mt-2">{tipo.descripcion}</p>
            <div class="mt-3">
              {tipo.ventajas.map((ventaja) => (
                <span class="inline-block text-xs bg-primary-light/10 text-primary-light px-2 py-1 rounded-full mr-1 mb-1">
                  <i class="fa-solid fa-check text-accent mr-1 text-[10px]"></i>
                  {ventaja}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 🔑 Características Clave -->
    <section id="caracteristicas" class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-6 md:p-8 mb-8 border border-border/50">
      <h2 class="text-2xl font-bold font-heading mb-4 text-text">Características Clave</h2>
      <p class="text-text-muted mb-6">Estos son los aspectos más importantes que debes considerar al elegir tus zapatillas de esgrima.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {caracteristicas.map((carac) => (
          <div class="bg-background rounded-2xl p-5 border border-border/40 hover:shadow-md hover:shadow-primary/5 transition">
            <div class="flex items-center gap-3 mb-2">
              <i class={`${carac.icono} text-2xl text-primary`}></i>
              <h3 class="font-bold text-text">{carac.nombre}</h3>
            </div>
            <p class="text-sm text-text-muted">{carac.descripcion}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 🏷️ Marcas Destacadas -->
    <section id="marcas" class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-6 md:p-8 mb-8 border border-border/50">
      <h2 class="text-2xl font-bold font-heading mb-4 text-text">Marcas Destacadas</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {marcas.map((marca) => (
          <div class="bg-background rounded-2xl p-3 border border-border/40 hover:border-border transition">
            <div class="flex items-center gap-3">
              <img 
                src={marca.icono} 
                alt={marca.nombre}
                class="w-16 h-16 object-contain shrink-0 rounded-2xl bg-surface"
                loading="lazy"
              />
              <div>
                <h3 class="font-bold text-text">{marca.nombre}</h3>
                <p class="text-sm text-text-muted">{marca.descripcion}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 📸 Modelos Populares -->
    <section id="modelos" class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-6 md:p-8 mb-8 border border-border/50">
      <h2 class="text-2xl font-bold font-heading mb-4 text-text">
        <i class="fa-solid fa-fire text-accent mr-2"></i>
        Modelos Populares
      </h2>
      <p class="text-text-muted mb-6">Los modelos más buscados y recomendados del mercado.</p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {modelosPopulares.map((modelo) => (
          <div class="bg-background rounded-2xl p-4 border border-border/40 hover:border-border hover:shadow-md hover:shadow-primary/5 transition text-center group">
            {modelo.imagen ? (
              <div class="relative overflow-hidden rounded-xl mb-2">
                <img 
                  src={modelo.imagen} 
                  alt={modelo.nombre} 
                  class="w-full h-24 object-cover rounded-xl group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute top-1 right-1 text-[10px] bg-primary/90 text-text-inverse px-1.5 py-0.5 rounded-full backdrop-blur-sm">
                  {modelo.pais}
                </div>
              </div>
            ) : (
              <div class="w-full h-24 bg-surface-muted/30 rounded-xl flex items-center justify-center text-2xl mb-2">👟</div>
            )}
            <p class="text-xs font-semibold text-text line-clamp-1">{modelo.nombre}</p>
            <p class="text-[10px] text-text-soft">{modelo.marca}</p>
            <span class="inline-block text-[10px] bg-surface-muted/50 text-text-muted px-1.5 py-0.5 rounded-full mt-1">
              {modelo.tipo}
            </span>
          </div>
        ))}
      </div>
      <div class="mt-4 text-xs text-text-soft text-center">
        <i class="fa-solid fa-circle-info mr-1"></i>
        Esta lista puede variar semanalmente.
      </div>
    </section>

    <!-- 📊 Comparativa de Modelos -->
    <section id="comparativa" class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-6 md:p-8 mb-8 border border-border/50">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <h2 class="text-2xl font-bold font-heading text-text">Comparativa de Modelos</h2>
        <span class="bg-accent/10 text-accent text-xs px-3 py-1 rounded-full font-semibold">Top 4</span>
        <span class="bg-primary-light/10 text-primary-light text-xs px-3 py-1 rounded-full font-semibold">
          <i class="fa-solid fa-flag mr-1"></i>
          Mejores diseños
        </span>
      </div>
      <p class="text-text-muted mb-6">Compara las características clave de los modelos más destacados del mercado, incluyendo opciones de diferentes regiones.</p>

      <div class="space-y-6">
        {comparativa.map((modelo, index) => (
