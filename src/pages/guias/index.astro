---
// src/pages/guias/index.astro
import Layout from '../../layouts/LayoutBase.astro';
import { FiHome, FiChevronRight } from 'react-icons/fi';

const guias = [
  {
    titulo: 'Zapatillas de Esgrima',
    descripcion: 'Guía completa para elegir las zapatillas perfectas según tu nivel y estilo.',
    icono: '👟',
    url: '/guias/zapatillas',
    fecha: '20 julio 2026',
    destacado: true
  },
  {
    titulo: 'Careta de Esgrima',
    descripcion: 'Comparativa de caretas: protección, visibilidad y marcas.',
    icono: '🎭',
    url: '/guias/caretas',
    fecha: 'Próximamente',
    destacado: false
  },
  {
    titulo: 'Trajes de Esgrima',
    descripcion: 'Todo sobre los trajes: materiales, niveles de protección y marcas.',
    icono: '👕',
    url: '/guias/trajes-esgrima',
    fecha: '26 de julio 2026',
    destacado: false
  },
  {
    titulo: 'Armas de Esgrima',
    descripcion: 'Comparativa entre florete, espada y sable. ¿Cuál elegir?',
    icono: '⚔️',
    url: '/guias/armas',
    fecha: 'Próximamente',
    destacado: false
  },
  {
    titulo: 'Guantes de Esgrima',
    descripcion: 'Protección, agarre y materiales. Guía para elegir el guante ideal.',
    icono: '🧤',
    url: '/guias/guantes',
    fecha: 'Próximamente',
    destacado: false
  },
  {
    titulo: 'Montar en un Club de Esgrima',
    descripcion: 'Guía para emprendedores sobre cómo crear y generar ingresos con un club de esgrima.',
    icono: '🏟️',
    url: '/guias/montar-club',
    fecha: '21 Julio 2026',
    destacado: true
  }
];

const titulo = 'Guías de Compra - Esgrima';
const descripcion = 'Encuentra las mejores guías de compra para equipamiento de esgrima: zapatillas, caretas, trajes y más.';
---

<Layout title={titulo} description={descripcion}>
  <div class="container mx-auto px-4 py-8">
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-primary transition-colors">
        <FiHome className="w-4 h-4 inline" />
        <span class="ml-1">Inicio</span>
      </a>
      <FiChevronRight className="w-4 h-4 text-gray-300" />
      <span class="text-primary font-medium">Guías de Compra</span>
    </nav>

    <div class="bg-linear-to-r from-primary to-primary-light text-white rounded-2xl p-8 mb-8">
      <h1 class="text-3xl md:text-4xl font-bold font-heading mb-2">Guías y Comparativa de Compras</h1>
      <p class="text-gray-300 text-lg">Encuentra la información que necesitas para elegir el mejor equipamiento de esgrima.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {guias.map((guia) => (
        <a 
          href={guia.url}
          class={`group bg-white rounded-xl shadow-md p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border ${
            guia.destacado ? 'border-gold' : 'border-gray-100'
          }`}
        >
          <div class="flex items-start gap-4">
            <div class="text-4xl shrink-0">{guia.icono}</div>
            <div>
              <div class="flex items-center gap-2">
                <h2 class="text-xl font-bold text-primary group-hover:text-gold transition-colors">
                  {guia.titulo}
                </h2>
                {guia.destacado && (
                  <span class="text-xs bg-gold/20 text-gold-dark px-2 py-0.5 rounded-full font-semibold">⭐ Destacada</span>
                )}
              </div>
              <p class="text-gray-600 text-sm mt-1">{guia.descripcion}</p>
              <p class="text-xs text-gray-400 mt-2">📅 {guia.fecha}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>