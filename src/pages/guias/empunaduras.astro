    tipo: 'Anatómica Italiana',
    material: 'Aluminio',
    peso: 'Ligero (80g)',
    tecnologia: 'Aluminio ligero con diseño italiano de precisión',    
    descripcion: 'Es la empuñadura italiana más ligera y resistente del mercado.',
    pros: ['Resistente', 'Ligera (80g)', 'Diseño italiano'],
    contras: ['Un poco rigida'],
    destacado: false,
    recomendacion: 'Para esgrimistas de élite conservadores.',
    enlace: 'https://negrini.com/en/products/anatomical-grip-337'
  },
  {
    id: 'jiang-fencing',
    nombre: 'Empuñadura Jiang',
    marca: 'Jiang Fencing',
    pais: 'China',
    imagen: '/images/guias/empunaduras/jiang.jpg',
    imagen_ampliada: '/images/guias/empunaduras/jiang.jpg',
    precio: 'Preguntar en web',
    tipo: 'Anatómica',
    material: 'Aluminio',
    peso: 'Ligero (80g)',
    tecnologia: 'Aluminio ligero con diseño italiano de precisión',    
    descripcion: 'Es la empuñadura china más buscada.',
    pros: ['Resistente', 'Ligera (80g)', 'Diseño italiano'],
    contras: ['Un poco rigida'],
    destacado: false,
    recomendacion: 'Para esgrimistas que quieren arriesgarse a probar algo desconocido.',
    enlace: 'http://en.jiangfencing.com/product/67.html'
  }
];

 

// ============================================
// 4. MARCAS DESTACADAS
// ============================================
const marcas = [
  { nombre: 'Leon Paul', descripcion: 'Pionera en innovación con su sistema de impresion 3D. La marca más prestigiosa y con mayor inversión en I+D.', icono: '/images/marcas/logo.svg' },
  { nombre: 'Negrini Fencing Line', descripcion: 'Marca italiana desde 1897. Calidad y diseño en productos personalizados para campeones mundiales.', icono: '/images/marcas/logo_negrini.webp' },
  { nombre: 'Prieur Sports', descripcion: 'Fabricante francés de esgrima con tradición artesanal. Calidad premium, especialistas en equipamiento clásico y de competición.', icono: '/images/marcas/logo_prieur.png' },
  { nombre: 'Allstar', descripcion: 'Nº1 mundial en esgrima. Empresa familiar alemana con 60 años de historia, innovación y calidad puntera para atletas de élite.', icono: '/images/marcas/logo_allstar.png' },
  { nombre: 'PBT Fencing', descripcion: 'Fabricante húngaro desde 1991. Equipo FIE de alta competición, proveedor oficial de la federación húngara.', icono: '/images/marcas/logo_pbt.jpg' },
  { nombre: 'Jiang Fencing', descripcion: 'Fabricante chino con 20+ años de experiencia. Equipo de esgrima de calidad y precio competitivo para competiciones nacionales e internacionales.', icono: '/images/marcas/logo_jiang.png' }
];

// ============================================
// 5. TIPOS DE EMPUÑADURAS
// ============================================
const tipos = [
  {
    nombre: 'Anatómicas Modernas',
    icono: 'fa-solid fa-hand-fist',
    descripcion: 'Diseñadas para adaptarse a la forma natural de la mano. Ofrecen un agarre más cómodo y reducen la tensión muscular. Las más avanzadas incorporan tecnología de escaneo 3D.',
    ventajas: ['Comodidad superior', 'Menos fatiga', 'Mayor control', 'Diseño ergonómico']
  },
  {
    nombre: 'De Alta Tecnología',
    icono: 'fa-solid fa-microchip',
    descripcion: 'Incorporan materiales avanzados como titanio, fibra de carbono y aleaciones de magnesio.',
    ventajas: ['Ultra-ligeras', 'Máxima transferencia de energía', 'Durabilidad extrema', 'Innovación constante']
  },
  {
    nombre: 'Ediciones Limitadas',
    icono: 'fa-solid fa-crown',
    descripcion: 'Empuñaduras producidas en cantidades muy reducidas, a menudo con materiales premium y diseños únicos. Son objetos de colección para esgrimistas apasionados.',
    ventajas: ['Exclusividad', 'Materiales premium', 'Valor de colección', 'Diseño único']
  }
];

// ============================================
// 6. CARACTERÍSTICAS CLAVE
// ============================================
const caracteristicas = [
  {
    nombre: 'Material',
    icono: 'fa-solid fa-flask',
    descripcion: 'El material determina el peso, la resistencia y la sensación de la empuñadura. Los materiales modernos incluyen titanio, fibra de carbono, aleación de magnesio y polímeros de alta densidad.'
  },
  {
    nombre: 'Peso',
    icono: 'fa-solid fa-weight-scale',
    descripcion: 'Las empuñaduras modernas buscan el peso mínimo sin sacrificar resistencia. Las más avanzadas pesan entre 35g y 40g, ofreciendo una ligereza extrema que mejora la velocidad y el control.'
  },
  {
    nombre: 'Tecnología de Fabricación',
    icono: 'fa-solid fa-gears',
    descripcion: 'Desde la impresión 3D, las técnicas de fabricación avanzadas permiten geometrías complejas y diseños imposibles con métodos tradicionales.'
  },
  {
    nombre: 'Ergonomía',
    icono: 'fa-solid fa-user-check',
    descripcion: 'El diseño ergonómico es clave para un agarre cómodo y eficiente. Las empuñaduras modernas se diseñan con software de simulación y escaneo biométrico para adaptarse a diferentes tipos de mano.'
  }
   
];
---

<Layout title={guia.titulo} description={guia.descripcion}>
  <div class="container mx-auto px-4 py-8 max-w-7xl">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-text-muted mb-8 flex-wrap">
      <a href="/" class="hover:text-primary transition-colors inline-flex items-center gap-1">
        <i class="fa-solid fa-house text-xs"></i>
        <span>Inicio</span>
      </a>
      <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
      <a href="/guias" class="hover:text-primary transition-colors">Guías</a>
      <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
      <span class="text-primary font-medium">Empuñaduras</span>
    </nav>

    <!-- Hero -->
    <div class="bg-linear-to-r from-primary to-primary-light text-text-inverse rounded-3xl p-8 mb-8 shadow-lg shadow-primary/10">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-2 text-sm text-accent mb-2">
            <i class="fa-solid fa-star text-xs"></i>
            <span>Guía Especializada</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-bold font-heading mb-2">
            {guia.titulo}
          </h1>
          <p class="text-surface-muted text-lg max-w-2xl">
            {guia.descripcion}  
          </p>
          <p class="text-surface-muted text-lg max-w-2xl mt-2">
            Tecnología de punta, diseños innovadores y las opciones más exclusivas para esgrimistas exigentes.
          </p>
          <div class="flex items-center gap-4 mt-4 text-sm text-surface-muted/80">
            <span><i class="fa-regular fa-calendar mr-1"></i> {guia.fecha}</span>
            <span>•</span>
            <span><i class="fa-regular fa-user mr-1"></i> {guia.autor}</span>
          </div>
        </div>
        <div class="shrink-0">
          <div class="p-6 text-center">
            <img 
              src="/images/guias/empunadura.jpg"
              alt="Empuñaduras de Esgrima"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 rounded-2xl"
              loading="lazy"
            />          
          </div>
        </div>
      </div>
    </div>

    <!-- 📋 Índice Rápido -->
    <div class="bg-surface-muted/30 rounded-3xl p-6 mb-8 border border-border/50">
      <h2 class="text-sm font-semibold text-text-muted mb-3">En esta guía:</h2>
      <div class="flex flex-wrap gap-3">
        <a href="#tecnologias" class="text-sm bg-surface text-text px-4 py-2 rounded-full hover:bg-primary hover:text-text-inverse transition border border-border/60">Tecnologías Avanzadas</a>
        <a href="#marcas" class="text-sm bg-surface text-text px-4 py-2 rounded-full hover:bg-primary hover:text-text-inverse transition border border-border/60">Marcas Destacadas</a>
        <a href="#tipos" class="text-sm bg-surface text-text px-4 py-2 rounded-full hover:bg-primary hover:text-text-inverse transition border border-border/60">Tipos de Empuñaduras</a>
        <a href="#caracteristicas" class="text-sm bg-surface text-text px-4 py-2 rounded-full hover:bg-primary hover:text-text-inverse transition border border-border/60">Características Clave</a>
        <a href="#comparativa" class="text-sm bg-surface text-text px-4 py-2 rounded-full hover:bg-primary hover:text-text-inverse transition border border-border/60">Comparativa</a>
        <a href="#recomendacion" class="text-sm bg-surface text-text px-4 py-2 rounded-full hover:bg-primary hover:text-text-inverse transition border border-border/60">¿Cuál elegir?</a>
      </div>
    </div>

    <!-- 🏷️ Marcas Destacadas -->
    <section id="marcas" class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-6 md:p-8 mb-8 border border-border/50">
      <h2 class="text-2xl font-bold font-heading mb-4 text-text">
        <i class="fa-solid fa-trophy text-primary mr-2"></i>
        Marcas Destacadas
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {marcas.map((marca) => (
          <div class="bg-background rounded-2xl p-5 border border-border/40 hover:border-border transition">
            <div class="flex items-center gap-3">
              <img 
                src={marca.icono} 
                alt={marca.nombre}
                class="w-16 h-16 object-contain shrink-0 rounded-2xl bg-surface"
                loading="lazy"
              />
              <div>
                <h3 class="font-bold text-text">{marca.nombre}</h3>
                <p class="text-sm text-text-muted">{marca.descripcion}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 👊 Tipos de Empuñaduras -->
    <section id="tipos" class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-6 md:p-8 mb-8 border border-border/50">
      <h2 class="text-2xl font-bold font-heading mb-4 text-text">Tipos de Empuñaduras Anatómicas</h2>
      <p class="text-text-muted mb-6">Cada tipo de empuñadura está diseñado para un perfil de esgrimista diferente.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {tipos.map((tipo) => (
          <div class="bg-background rounded-2xl p-6 border border-border/40 hover:border-border transition">
            <i class={`${tipo.icono} text-4xl text-primary mb-3`}></i>
            <h3 class="text-xl font-bold font-heading text-text">{tipo.nombre}</h3>
            <p class="text-sm text-text-muted mt-2">{tipo.descripcion}</p>
            <div class="mt-3">
              {tipo.ventajas.map((ventaja) => (
                <span class="inline-block text-xs bg-primary-light/10 text-primary-light px-2 py-1 rounded-full mr-1 mb-1">
                  <i class="fa-solid fa-check text-accent mr-1 text-[10px]"></i>
                  {ventaja}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 🔑 Características Clave -->
    <section id="caracteristicas" class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-6 md:p-8 mb-8 border border-border/50">
      <h2 class="text-2xl font-bold font-heading mb-4 text-text">Características Clave</h2>
      <p class="text-text-muted mb-6">Estos son los aspectos más importantes que debes considerar al elegir una empuñadura anatómica avanzada.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {caracteristicas.map((carac) => (
          <div class="bg-background rounded-2xl p-5 border border-border/40 hover:shadow-md hover:shadow-primary/5 transition">
            <div class="flex items-center gap-3 mb-2">
              <i class={`${carac.icono} text-2xl text-primary`}></i>
              <h3 class="font-bold text-text">{carac.nombre}</h3>
            </div>
            <p class="text-sm text-text-muted">{carac.descripcion}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 📊 Comparativa de Empuñaduras -->
    <section id="comparativa" class="bg-surface rounded-3xl shadow-md shadow-primary/5 p-6 md:p-8 mb-8 border border-border/50">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <h2 class="text-2xl font-bold font-heading text-text">
          <i class="fa-solid fa-hand-fist text-primary mr-2"></i>
          Comparativa de Empuñaduras Anatómicas
        </h2>
        <span class="bg-accent/10 text-accent text-xs px-3 py-1 rounded-full font-semibold">Top 6</span>
        <span class="bg-primary-light/10 text-primary-light text-xs px-3 py-1 rounded-full font-semibold">
          <i class="fa-solid fa-gem mr-1"></i>
          Incluye modelos raros
        </span>
      </div>
      <p class="text-text-muted mb-6">Compara las empuñaduras más avanzadas y exclusivas del mercado.</p>

      <div class="space-y-6">
        {empunaduras.map((modelo) => (
          <div class={`bg-background rounded-2xl p-6 border transition hover:shadow-lg hover:shadow-primary/5 ${
            modelo.destacado ? 'border-accent shadow-md shadow-accent/5' : 'border-border/40 hover:border-border'
          }`}>
            <div class="flex flex-col md:flex-row md:items-start gap-6">
              <!-- Columna Izquierda: Imagen -->
              <div class="md:w-64 shrink-0">
                {modelo.destacado && (
                  <div class="bg-accent text-text-inverse text-xs font-bold px-3 py-1 rounded-full inline-block mb-3">
                    <i class="fa-solid fa-star mr-1"></i>
                    Top Innovation
                  </div>
                )}
                
                <div class="flex items-center gap-2 mb-3 flex-wrap">
                  <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${
                    modelo.pais === 'China' 
                      ? 'bg-accent/10 text-accent border border-accent/20' 
                      : 'bg-primary-light/10 text-primary-light border border-primary-light/20'
                  }`}>
                    <i class="fa-solid fa-flag mr-1"></i>
                    {modelo.pais}
                  </span>
                  <span class="text-sm font-bold text-accent ml-auto">{modelo.precio}</span>
                </div>
                
                <div class="relative group cursor-pointer" 
                     data-lightbox-id={modelo.id}
                     data-lightbox-img={modelo.imagen_ampliada || modelo.imagen}
                     data-lightbox-name={modelo.nombre}
                     data-lightbox-marca={modelo.marca}
                     data-lightbox-tipo={modelo.tipo}>
                  {modelo.imagen ? (
                    <div class="relative overflow-hidden rounded-2xl bg-surface-muted/30">
                      <img 
                        src={modelo.imagen} 
                        alt={modelo.nombre} 
                        class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
                      />
                      <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition bg-primary/40">
                        <i class="fa-solid fa-magnifying-glass-plus text-text-inverse text-3xl"></i>
                      </div>
                    </div>
                  ) : (
                    <div class="w-full h-48 bg-surface-muted/30 rounded-2xl flex items-center justify-center text-6xl">⚔️</div>
                  )}
                </div>
                
                <div class="mt-3">
                  <a 
                    href={modelo.enlace} 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block text-center text-sm bg-primary text-text-inverse py-2.5 rounded-xl hover:bg-primary-light transition font-semibold"
                  >
                    <i class="fa-solid fa-cart-shopping mr-2"></i>
                    Ver en tienda
                  </a>
                </div>
              </div>

              <!-- Columna Derecha: Información -->
              <div class="flex-1">
                <div class="flex items-start justify-between mb-3 gap-3">
                  <div>
                    <h3 class="text-2xl font-bold text-text">{modelo.nombre}</h3>
                    <span class="text-sm font-semibold text-primary bg-primary/10 px-3 py-1 rounded-2xl inline-block mt-1">
                      {modelo.marca}
                    </span>
                  </div>
                  <span class="text-lg font-bold text-accent whitespace-nowrap">{modelo.precio}</span>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm text-text-muted">
                  <div><span class="font-semibold text-text">Tipo:</span> {modelo.tipo}</div>
                  <div><span class="font-semibold text-text">Material:</span> {modelo.material}</div>
