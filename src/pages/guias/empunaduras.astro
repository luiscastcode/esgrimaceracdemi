  imagen: '/images/guias/empunaduras-hero.jpg'
};

// ============================================
// 2. EMPUÑADURAS DESTACADAS (MODERNAS Y AVANZADAS)
// ============================================
const empunaduras = [
  {
    id: 'leon-paul-magnetic',
