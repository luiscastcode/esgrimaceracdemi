    descripcion: 'Es la empuñadura italiana más ligera y resistente del mercado.',
    pros: ['Resistente', 'Ligera (80g)', 'Diseño italiano'],
    contras: ['Un poco rigida'],
    destacado: false,
    recomendacion: 'Para esgrimistas de élite conservadores.',
    enlace: 'https://negrini.com/en/products/anatomical-grip-337'
  },
  {
    id: 'jiang-fencing',
    nombre: 'Empuñadura Jiang',
    marca: 'Jiang Fencing',
    pais: 'China',
    imagen: '/images/guias/empunaduras/jiang.jpg',
    imagen_ampliada: '/images/guias/empunaduras/jiang.jpg',
    precio: 'Preguntar en web',
    tipo: 'Anatómica',
    material: 'Aluminio',
    peso: 'Ligero (80g)',
    tecnologia: 'Aluminio ligero con diseño italiano de precisión',    
    descripcion: 'Es la empuñadura china más buscada.',
    pros: ['Resistente', 'Ligera (80g)', 'Diseño italiano'],
    contras: ['Un poco rigida'],
    destacado: false,
    recomendacion: 'Para esgrimistas que quieren arriesgarse a probar algo desconocido.',
    enlace: 'http://en.jiangfencing.com/product/67.html'
  }
];

 

// ============================================
// 4. MARCAS DESTACADAS
// ============================================
const marcas = [
  { nombre: 'Leon Paul', descripcion: 'Pionera en innovación con su sistema de impresion 3D. La marca más prestigiosa y con mayor inversión en I+D.', icono: '/images/marcas/logo.svg' },
  { nombre: 'Negrini Fencing Line', descripcion: 'Marca italiana desde 1897. Calidad y diseño en productos personalizados para campeones mundiales.', icono: '/images/marcas/logo_negrini.webp' },
  { nombre: 'Prieur Sports', descripcion: 'Fabricante francés de esgrima con tradición artesanal. Calidad premium, especialistas en equipamiento clásico y de competición.', icono: '/images/marcas/logo_prieur.png' },
  { nombre: 'Allstar', descripcion: 'Nº1 mundial en esgrima. Empresa familiar alemana con 60 años de historia, innovación y calidad puntera para atletas de élite.', icono: '/images/marcas/logo_allstar.png' },
  { nombre: 'PBT Fencing', descripcion: 'Fabricante húngaro desde 1991. Equipo FIE de alta competición, proveedor oficial de la federación húngara.', icono: '/images/marcas/logo_pbt.jpg' },
  { nombre: 'Jiang Fencing', descripcion: 'Fabricante chino con 20+ años de experiencia. Equipo de esgrima de calidad y precio competitivo para competiciones nacionales e internacionales.', icono: '/images/marcas/logo_jiang.png' }
];

// ============================================
// 5. TIPOS DE EMPUÑADURAS
// ============================================
const tipos = [
  {
    nombre: 'Anatómicas Modernas',
    icono: 'fa-solid fa-hand-fist',
    descripcion: 'Diseñadas para adaptarse a la forma natural de la mano. Ofrecen un agarre más cómodo y reducen la tensión muscular. Las más avanzadas incorporan tecnología de escaneo 3D.',
    ventajas: ['Comodidad superior', 'Menos fatiga', 'Mayor control', 'Diseño ergonómico']
  },
  {
    nombre: 'De Alta Tecnología',
    icono: 'fa-solid fa-microchip',
    descripcion: 'Incorporan materiales avanzados como titanio, fibra de carbono y aleaciones de magnesio.',
    ventajas: ['Ultra-ligeras', 'Máxima transferencia de energía', 'Durabilidad extrema', 'Innovación constante']
  },
  {
    nombre: 'Ediciones Limitadas',
    icono: 'fa-solid fa-crown',
    descripcion: 'Empuñaduras producidas en cantidades muy reducidas, a menudo con materiales premium y diseños únicos. Son objetos de colección para esgrimistas apasionados.',
    ventajas: ['Exclusividad', 'Materiales premium', 'Valor de colección', 'Diseño único']
  }
];

// ============================================
// 6. CARACTERÍSTICAS CLAVE
// ============================================
const caracteristicas = [
  {
    nombre: 'Material',
    icono: 'fa-solid fa-flask',
    descripcion: 'El material determina el peso, la resistencia y la sensación de la empuñadura. Los materiales modernos incluyen titanio, fibra de carbono, aleación de magnesio y polímeros de alta densidad.'
  },
  {
    nombre: 'Peso',
    icono: 'fa-solid fa-weight-scale',
    descripcion: 'Las empuñaduras modernas buscan el peso mínimo sin sacrificar resistencia. Las más avanzadas pesan entre 35g y 40g, ofreciendo una ligereza extrema que mejora la velocidad y el control.'
  },
  {
    nombre: 'Tecnología de Fabricación',
    icono: 'fa-solid fa-gears',
    descripcion: 'Desde la impresión 3D, las técnicas de fabricación avanzadas permiten geometrías complejas y diseños imposibles con métodos tradicionales.'
  },
  {
    nombre: 'Ergonomía',
    icono: 'fa-solid fa-user-check',
    descripcion: 'El diseño ergonómico es clave para un agarre cómodo y eficiente. Las empuñaduras modernas se diseñan con software de simulación y escaneo biométrico para adaptarse a diferentes tipos de mano.'
  }
   
];
---

<Layout title={guia.titulo} description={guia.descripcion}>
  <div class="container mx-auto px-4 py-8 max-w-7xl">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8 flex-wrap">
      <a href="/" class="hover:text-primary transition-colors">
        <FiHome className="w-4 h-4 inline" />
        <span class="ml-1">Inicio</span>
      </a>
      <FiChevronRight className="w-4 h-4 text-gray-300" />
      <a href="/guias" class="hover:text-primary transition-colors">Guías</a>
      <FiChevronRight className="w-4 h-4 text-gray-300" />
      <span class="text-primary font-medium">Empuñaduras</span>
    </nav>

    <!-- Hero -->
    <div class="bg-linear-to-r from-primary to-primary-light text-white rounded-2xl p-8 mb-8">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-2 text-sm text-gold mb-2">
            <FiStar className="w-4 h-4" />
            <span>Guía Especializada</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-bold font-heading mb-2">
            {guia.titulo}
          </h1>
          <p class="text-gray-300 text-lg">
            {guia.descripcion}  
          </p>
          <p class="text-gray-300 text-lg">
             Tecnología de punta, diseños innovadores y las opciones más exclusivas para esgrimistas exigentes.
          </p>
          <div class="flex items-center gap-4 mt-4 text-sm text-gray-400">
            <span><i class="fa-regular fa-calendar"></i> {guia.fecha}</span>
            <span>•</span>
            <span><i class="fa-regular fa-user"></i> {guia.autor}</span>
          </div>
        </div>
        <div class="shrink-0">
          <div class="p-6 text-center">
            <img 
                  src="/images/guias/empunadura.jpg"
                  alt="Empuñaduras de Esgrima"
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 rounded-2xl"
                  loading="lazy"
                />          
          </div>
        </div>
      </div>
    </div>

    <!-- 📋 Índice Rápido -->
    <div class="bg-gray-50 rounded-2xl p-6 mb-8 border border-gray-200">
      <h2 class="text-sm font-semibold text-gray-600 mb-3">En esta guía:</h2>
      <div class="flex flex-wrap gap-3">
        <a href="#tecnologias" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Tecnologías Avanzadas</a>
        <a href="#marcas" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Marcas Destacadas</a>
        <a href="#tipos" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Tipos de Empuñaduras</a>
        <a href="#caracteristicas" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Características Clave</a>
        <a href="#comparativa" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Comparativa</a>
        <a href="#recomendacion" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">¿Cuál elegir?</a>
      </div>
    </div>

     

    <!-- 🏷️ Marcas Destacadas -->
    <section id="marcas" class="bg-white rounded-2xl shadow-md p-6 md:p-8 mb-8 border border-gray-100">
      <h2 class="text-2xl font-bold font-heading mb-4">
        <i class="fa-solid fa-trophy text-primary mr-2"></i>
        Marcas Destacadas
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {marcas.map((marca) => (
          <div class="bg-gray-50 rounded-xl p-5 border border-gray-200 hover:border-primary transition">
            <div class="flex items-center gap-3">
              <img 
                  src={marca.icono} 
                  alt={marca.nombre}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              <div>
                <h3 class="font-bold text-primary">{marca.nombre}</h3>
                <p class="text-sm text-gray-600">{marca.descripcion}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 👊 Tipos de Empuñaduras -->
    <section id="tipos" class="bg-white rounded-2xl shadow-md p-6 md:p-8 mb-8 border border-gray-100">
      <h2 class="text-2xl font-bold font-heading mb-4">Tipos de Empuñaduras Anatómicas</h2>
      <p class="text-gray-600 mb-6">Cada tipo de empuñadura está diseñado para un perfil de esgrimista diferente.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {tipos.map((tipo) => (
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-200 hover:border-primary transition">
            <i class={`${tipo.icono} text-4xl text-primary mb-3`}></i>
            <h3 class="text-xl font-bold font-heading text-primary">{tipo.nombre}</h3>
            <p class="text-sm text-gray-600 mt-2">{tipo.descripcion}</p>
            <div class="mt-3">
              {tipo.ventajas.map((ventaja) => (
                <span key={ventaja} class="inline-block text-xs bg-green-50 text-green-700 px-2 py-1 rounded-full mr-1 mb-1">
                  <i class="fa-solid fa-check text-green-500 mr-1"></i>
                  {ventaja}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 🔑 Características Clave -->
    <section id="caracteristicas" class="bg-white rounded-2xl shadow-md p-6 md:p-8 mb-8 border border-gray-100">
      <h2 class="text-2xl font-bold font-heading mb-4">Características Clave</h2>
      <p class="text-gray-600 mb-6">Estos son los aspectos más importantes que debes considerar al elegir una empuñadura anatómica avanzada.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {caracteristicas.map((carac) => (
          <div class="bg-gray-50 rounded-xl p-5 border border-gray-200 hover:shadow-md transition">
            <div class="flex items-center gap-3 mb-2">
              <i class={`${carac.icono} text-2xl text-primary`}></i>
              <h3 class="font-bold text-primary">{carac.nombre}</h3>
            </div>
            <p class="text-sm text-gray-600">{carac.descripcion}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 📊 Comparativa de Empuñaduras -->
    <section id="comparativa" class="bg-white rounded-2xl shadow-md p-6 md:p-8 mb-8 border border-gray-100">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <h2 class="text-2xl font-bold font-heading">
          <i class="fa-solid fa-hand-fist text-primary mr-2"></i>
          Comparativa de Empuñaduras Anatómicas
        </h2>
        <span class="bg-gold/20 text-gold-dark text-xs px-3 py-1 rounded-full font-semibold">Top 6</span>
        <span class="bg-purple-50 text-purple-600 text-xs px-3 py-1 rounded-full font-semibold">
          <i class="fa-solid fa-diamond mr-1"></i>
          Incluye modelos raros
        </span>
      </div>
      <p class="text-gray-600 mb-6">Compara las empuñaduras más avanzadas y exclusivas del mercado.</p>

      <div class="space-y-6">
        {empunaduras.map((modelo) => (
          <div class={`bg-gray-50 rounded-xl p-6 border-2 transition hover:shadow-lg ${
            modelo.destacado ? 'border-gold shadow-md' : 'border-gray-200 hover:border-primary'
          }`}>
            <div class="flex flex-col md:flex-row md:items-start gap-6">
              <!-- Columna Izquierda: Imagen -->
              <div class="md:w-64 shrink-0">
                {modelo.destacado && (
                  <div class="bg-gold text-primary text-xs font-bold px-3 py-1 rounded-full inline-block mb-3">
                    <i class="fa-solid fa-star mr-1"></i>
                    Top Innovation
                  </div>
                )}
                
                <div class="flex items-center gap-2 mb-3 flex-wrap">
                  <span class={`text-xs font-bold px-2 py-0.5 rounded-full ${
                    modelo.pais === 'China' 
                      ? 'bg-red-50 text-red-600 border border-red-200' 
                      : 'bg-blue-50 text-blue-600 border border-blue-200'
                  }`}>
                    <i class="fa-solid fa-flag mr-1"></i>
                    {modelo.pais}
                  </span>
                   
                  <span class="text-sm font-bold text-gold-dark ml-auto">{modelo.precio}</span>
                </div>
                
                <div class="relative group cursor-pointer" 
                     data-lightbox-id={modelo.id}
                     data-lightbox-img={modelo.imagen_ampliada || modelo.imagen}
                     data-lightbox-name={modelo.nombre}
                     data-lightbox-marca={modelo.marca}
                     data-lightbox-tipo={modelo.tipo}>
                  {modelo.imagen ? (
                    <div class="relative overflow-hidden rounded-xl bg-gray-100">
                      <img 
                        src={modelo.imagen} 
                        alt={modelo.nombre} 
                        class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
                      />
                      <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition bg-black/30">
                        <i class="fa-solid fa-magnifying-glass-plus text-white text-3xl"></i>
                      </div>
                    </div>
                  ) : (
                    <div class="w-full h-48 bg-gray-200 rounded-xl flex items-center justify-center text-6xl">⚔️</div>
                  )}
                </div>
                
                <div class="mt-3">
                  <a 
                    href={modelo.enlace} 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block text-center text-sm bg-primary text-white py-2.5 rounded-lg hover:bg-primary-light transition"
                  >
                    <i class="fa-solid fa-cart-shopping mr-2"></i>
                    Ver en tienda
                  </a>
                </div>
              </div>

              <!-- Columna Derecha: Información -->
              <div class="flex-1">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <h3 class="text-2xl font-bold text-primary">{modelo.nombre}</h3>
                    <span class="text-sm font-bold text-white bg-blue-950 px-2 py-1 rounded-2xl">
                      {modelo.marca}
                    </span>
                  </div>
                  <span class="text-lg font-bold text-gold-dark">{modelo.precio}</span>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                  <div><span class="font-semibold">Tipo:</span> {modelo.tipo}</div>
                  <div><span class="font-semibold">Material:</span> {modelo.material}</div>
                  <div><span class="font-semibold">Peso:</span> {modelo.peso}</div>
                  <div><span class="font-semibold">Tecnología:</span> {modelo.tecnologia}</div>
                </div>

                <div class="mt-3 p-3 bg-primary/5 rounded-lg">
                  <p class="text-sm text-gray-600">{modelo.descripcion}</p>
                </div>

                <div class="mt-4 pt-4 border-t border-gray-200">
                  <p class="text-sm font-semibold text-primary">
                    <i class="fa-solid fa-circle-check text-green-500 mr-1"></i>
                    Pros:
                  </p>
