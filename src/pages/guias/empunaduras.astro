    imagen_ampliada: '/images/guias/empunaduras/3664.png',
    precio: '~$15 USD',
    tipo: 'Anatómica Flexible',
    material: 'Aluminio',
    peso: 'Ligero (88-90g)',
    tecnologia: 'Aluminio con flexibilidad controlada',
    
