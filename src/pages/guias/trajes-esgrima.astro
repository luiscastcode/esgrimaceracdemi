  }
];

// ============================================
// 9. Reglamento FIE
// ============================================
const reglamentoFIE = {
  chaquetilla: '800N mínimo para competiciones FIE',
  pantalon: '800N mínimo para competiciones FIE',
  caretaBarbada: '1600N obligatorio para la barbada de la careta en FIE',
