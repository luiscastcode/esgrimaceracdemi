    uso: 'Entrenamiento, competiciones nacionales, principiantes',
    precio: 'Económico',
    recomendado: 'Principiantes y entrenamiento diario',
    color: 'bg-green-50 border-green-200'
  },
  {
    nombre: '800N',
    icono: 'fa-solid fa-shield-halved',
