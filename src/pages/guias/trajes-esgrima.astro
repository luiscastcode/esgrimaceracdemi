---

<Layout title={guia.titulo} description={guia.descripcion}>
  <div class="container mx-auto px-4 py-8 max-w-7xl">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8 flex-wrap">
      <a href="/" class="hover:text-primary transition-colors">
        <FiHome className="w-4 h-4 inline" />
        <span class="ml-1">Inicio</span>
      </a>
      <FiChevronRight className="w-4 h-4 text-gray-300" />
      <a href="/guias" class="hover:text-primary transition-colors">Guías</a>
      <FiChevronRight className="w-4 h-4 text-gray-300" />
      <span class="text-primary font-medium">Trajes</span>
    </nav>

    <!-- Hero -->
    <div class="bg-linear-to-r from-primary to-primary-light text-white rounded-2xl p-8 mb-8">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-2 text-sm text-gold mb-2">
            <FiStar className="w-4 h-4" />
            <span>Guía de Compra</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-bold font-heading mb-2">
            {guia.titulo}
          </h1>
          <p class="text-gray-300 text-lg max-w-2xl">
            {guia.descripcion}
          </p>
          <div class="flex items-center gap-4 mt-4 text-sm text-gray-400">
            <span><i class="fa-regular fa-calendar"></i> {guia.fecha}</span>
            <span>•</span>
            <span><i class="fa-regular fa-user"></i> {guia.autor}</span>
          </div>
        </div>
        <div class="shrink-0">
          <div class="bg-white/10 rounded-2xl p-6 text-center">
            <i class="fa-solid fa-vest text-5xl text-gold"></i>
            <p class="text-sm text-gray-300 mt-2">Uniformes de Esgrima</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 📋 Índice Rápido -->
    <div class="bg-gray-50 rounded-2xl p-6 mb-8 border border-gray-200">
      <h2 class="text-sm font-semibold text-gray-600 mb-3">En esta guía:</h2>
      <div class="flex flex-wrap gap-3">
        <a href="#niveles" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Niveles de Protección</a>
        <a href="#comparativa350" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">350N (Principiantes)</a>
        <a href="#comparativa1600" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">800N (Profesional)</a>
        <a href="#materiales" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Materiales</a>
        <a href="#reglamento" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">Reglamento FIE</a>
        <a href="#recomendacion" class="text-sm bg-white px-4 py-2 rounded-full hover:bg-primary hover:text-white transition border border-gray-200">¿Cuál elegir?</a>
      </div>
    </div>

    <!-- 🛡️ Niveles de Protección -->
    <section id="niveles" class="bg-white rounded-2xl shadow-md p-6 md:p-8 mb-8 border border-gray-100">
      <h2 class="text-2xl font-bold font-heading mb-4">
        <i class="fa-solid fa-shield-halved text-primary mr-2"></i>
        Niveles de Protección: 350N, 800N y 1600N
      </h2>
      <p class="text-gray-600 mb-6">
        La resistencia a la perforación se mide en Newtons (N). Estos son los estándares internacionales para uniformes de esgrima:
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {nivelesProteccion.map((nivel) => (
          <div class={`rounded-xl p-5 border-2 ${nivel.color} bg-white transition hover:shadow-md`}>
            <div class="flex items-center gap-2 mb-2">
              <i class={`${nivel.icono} text-2xl text-primary`}></i>
              <h3 class="text-xl font-bold text-primary">{nivel.nombre}</h3>
            </div>
            <p class="text-sm text-gray-600">{nivel.descripcion}</p>
            <div class="mt-3 space-y-1 text-xs">
              <p><span class="font-semibold">Uso:</span> {nivel.uso}</p>
              <p><span class="font-semibold">Precio:</span> {nivel.precio}</p>
              <p><span class="font-semibold">Recomendado para:</span> {nivel.recomendado}</p>
            </div>
          </div>
        ))}
      </div>
      
      <div class="mt-4 p-4 bg-blue-50 border border-blue-200 rounded-xl">
        <p class="text-sm text-blue-700">
          <i class="fa-solid fa-circle-info mr-2"></i>
          <strong>Importante:</strong> La FIE exige un mínimo de <strong>800N</strong> para chaquetilla y pantalón en competiciones internacionales, y <strong>1600N</strong> para la barbada de la careta.
        </p>
      </div>
    </section>

    <!-- 📊 Comparativa 350N (Principiantes) -->
    <section id="comparativa350" class="bg-white rounded-2xl shadow-md p-6 md:p-8 mb-8 border border-gray-100">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <h2 class="text-2xl font-bold font-heading">
          <i class="fa-solid fa-seedling text-green-500 mr-2"></i>
          Comparativa 350N - Principiantes
        </h2>
        <span class="bg-green-50 text-green-600 text-xs px-3 py-1 rounded-full font-semibold">Económicos</span>
        <span class="bg-gray-100 text-gray-500 text-xs px-3 py-1 rounded-full">Entrenamiento</span>
      </div>
      <p class="text-gray-600 mb-6">Los uniformes 350N son la opción más económica y popular para principiantes y entrenamiento diario. Ofrecen protección básica sin el coste de los materiales balísticos.</p>

      <div class="space-y-6">
        {comparativa350N.map((modelo) => (
          <div class={`bg-gray-50 rounded-xl p-6 border-2 transition hover:shadow-lg ${
            modelo.destacado ? 'border-green-500 shadow-md' : 'border-gray-200 hover:border-primary'
          }`}>
            <div class="flex flex-col md:flex-row md:items-start gap-6">
              <!-- Columna Izquierda: Imagen -->
              <div class="md:w-64 shrink-0">
                {modelo.destacado && (
                  <div class="bg-green-500 text-white text-xs font-bold px-3 py-1 rounded-full inline-block mb-3">
                    <i class="fa-solid fa-star mr-1"></i>
                    Mejor Opción
                  </div>
                )}
                
                <div class="flex items-center gap-2 mb-3">
                  <span class={`text-xs px-2 py-0.5 rounded-full ${
                    modelo.pais === 'China' 
                      ? 'bg-red-50 text-red-600 border border-red-200' 
                      : 'bg-blue-50 text-blue-600 border border-blue-200'
                  }`}>
                    <i class="fa-solid fa-flag mr-1"></i>
                    {modelo.pais}
                  </span>
                  <span class="text-sm font-bold text-green-600 ml-auto">{modelo.precio}</span>
                </div>
                
                <div class="relative group cursor-pointer" 
                     data-lightbox-id={modelo.id}
                     data-lightbox-img={modelo.imagen_ampliada || modelo.imagen}
                     data-lightbox-name={modelo.nombre}
                     data-lightbox-marca={modelo.marca}
                     data-lightbox-tipo={modelo.tipo}>
                  {modelo.imagen ? (
                    <div class="relative overflow-hidden rounded-xl bg-gray-100">
                      <img 
                        src={modelo.imagen} 
                        alt={modelo.nombre} 
                        class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
                      />
                      <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition bg-black/30">
                        <i class="fa-solid fa-magnifying-glass-plus text-white text-3xl"></i>
                      </div>
                    </div>
                  ) : (
                    <div class="w-full h-48 bg-gray-200 rounded-xl flex items-center justify-center text-6xl">👕</div>
                  )}
                </div>
                
                <div class="mt-3">
                  <a 
                    href={modelo.enlace} 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block text-center text-sm bg-primary text-white py-2.5 rounded-lg hover:bg-primary-light transition"
                  >
                    <i class="fa-solid fa-cart-shopping mr-2"></i>
                    Ver en tienda
                  </a>
                </div>
              </div>

              <!-- Columna Derecha: Información -->
              <div class="flex-1">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <h3 class="text-2xl font-bold text-primary">{modelo.nombre}</h3>
                    <span class="text-sm text-gray-500">{modelo.marca}</span>
                  </div>
                  <span class="text-lg font-bold text-green-600">{modelo.precio}</span>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                  <div><span class="font-semibold">Tipo:</span> {modelo.tipo}</div>
                  <div><span class="font-semibold">Material:</span> {modelo.material}</div>
                  <div><span class="font-semibold">Peso:</span> {modelo.peso}</div>
                  <div><span class="font-semibold">Ajuste:</span> {modelo.ajuste}</div>
                  <div><span class="font-semibold">Protección:</span> {modelo.proteccion}</div>
                  <div><span class="font-semibold">Transpirabilidad:</span> {modelo.transpirabilidad}</div>
                </div>

                <div class="mt-4 pt-4 border-t border-gray-200">
                  <p class="text-sm font-semibold text-primary">
                    <i class="fa-solid fa-circle-check text-green-500 mr-1"></i>
                    Pros:
                  </p>
