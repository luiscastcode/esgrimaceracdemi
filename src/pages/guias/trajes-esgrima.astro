// ============================================
const tipos = [
  {
    nombre: 'Entrenamiento',
    icono: 'fa-solid fa-dumbbell',
    descripcion: 'Diseñados para el uso diario. Son más económicos, ligeros y cómodos. Perfectos para principiantes y entrenamiento regular. Generalmente 350N.',
    ventajas: ['Económicos', 'Ligeros', 'Cómodos', 'Ideales para principiantes']
  },
  {
    nombre: 'Competición Nacional',
    icono: 'fa-solid fa-flag',
