  {
    nombre: 'Dyneema',
    descripcion: 'Fibra de ultra-alta resistencia molecular. Es el material más ligero y resistente del mercado. No degrada su forma con el tiempo, manteniendo la protección y comodidad.',
    icono: 'fa-solid fa-gem',
    uso: 'Uniformes 800N y 1600N'
  },
  {
    nombre: 'Kevlar',
    descripcion: 'Fibra balística conocida por su alta resistencia a la perforación. Más rígido que el Dyneema pero igual de efectivo. Usado en uniformes de alta protección.',
    icono: 'fa-solid fa-shield',
    uso: 'Uniformes 800N y 1600N'
  },
  {
    nombre: 'Poliester de Alta Resistencia',
    descripcion: 'Material básico para uniformes 350N. Ofrece una protección adecuada para entrenamiento y es más económico que los materiales balísticos.',
    icono: 'fa-solid fa-vest',
    uso: 'Uniformes 350N'
  }
];

// ============================================
// 6. Marcas Destacadas
// ============================================
const marcas = [
  { nombre: 'Leon Paul', descripcion: 'La marca más prestigiosa del mundo. Innovación constante y materiales de última generación. Referencia en competiciones FIE.', icono: 'fa-solid fa-crown' },
  { nombre: 'Allstar', descripcion: 'Marca alemana con décadas de experiencia. Ofrece uniformes de alta calidad para todos los niveles, desde 350N hasta 1600N.', icono: 'fa-solid fa-star' },
