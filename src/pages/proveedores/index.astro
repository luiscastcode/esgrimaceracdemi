---
import Layout from '../../layouts/LayoutBase.astro';
import proveedoresData from '../../data/proveedores.json';
import BannerPub from '../../components/BannerPub.astro';


// 🔥 Configuración de paginación
const PROVEEDORES_POR_PAGINA = 12;
const proveedores = proveedoresData.proveedores || [];
const totalProveedores = proveedores.length;
const totalPaginas = Math.ceil(totalProveedores / PROVEEDORES_POR_PAGINA);

// 🔥 Obtener página actual
const url = new URL(Astro.request.url);
const page = parseInt(url.searchParams.get('page') || '1', 10);
const paginaActual = Math.max(1, Math.min(page, totalPaginas || 1));

// 🔥 Calcular índices para la página actual
const inicio = (paginaActual - 1) * PROVEEDORES_POR_PAGINA;
const fin = Math.min(inicio + PROVEEDORES_POR_PAGINA, totalProveedores);
const proveedoresPagina = proveedores.slice(inicio, fin);

// 🔥 Estadísticas
const tipos = [...new Set(proveedores.map(p => p.tipo))];
const totalDestacados = proveedores.filter(p => p.destacado).length;
const categorias = [...new Set(proveedores.map(p => p.categoria))];
 

// 🔥 Pasar datos a JavaScript de forma segura
const proveedoresJSON = JSON.stringify(proveedoresPagina);

const titulo = 'Proveedores de Equipos de Esgrima en Venezuela';
const descripcion = `Encuentra los mejores proveedores de material, servicios y equipamiento para esgrima en todo el país. ${totalProveedores} proveedores disponibles.`;
---

<Layout title={titulo} description={descripcion}>
  <div class="container mx-auto px-4 py-8 max-w-7xl">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-text-muted mb-8 flex-wrap">
      <a href="/" class="hover:text-primary transition-colors inline-flex items-center gap-1">
        <i class="fa-solid fa-house text-xs"></i>
        <span>Inicio</span>
      </a>
      <i class="fa-solid fa-chevron-right text-[10px] text-text-soft"></i>
      <span class="text-primary font-medium">Proveedores</span>
    </nav>

    <!-- Hero / Header -->
<div class="bg-linear-to-r from-primary to-primary-light text-text-inverse rounded-3xl p-8 mb-8 shadow-lg shadow-primary/10 relative overflow-hidden">
  <!-- Decoración sutil -->
  <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-text-inverse/5 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-16 w-56 h-56 rounded-full bg-accent/10 blur-3xl pointer-events-none"></div>

  <div class="relative flex flex-col lg:flex-row lg:items-center justify-between gap-8">
    <!-- Columna Izquierda: Texto + CTA -->
    <div class="flex-1">
      <div class="inline-flex items-center gap-2 bg-text-inverse/10 border border-text-inverse/15 rounded-full px-3 py-1 mb-3">
        <span class="w-2 h-2 rounded-full bg-accent"></span>
        <span class="text-xs font-semibold text-surface-muted uppercase tracking-wider">
          Directorio Nacional
        </span>
      </div>

      <h1 class="text-3xl md:text-4xl font-bold font-heading mb-3">
        Proveedores de Esgrima
      </h1>
      <p class="text-surface-muted text-lg max-w-xl mb-6">
        Encuentra <strong class="text-text-inverse font-semibold">{totalProveedores} proveedores</strong> especializados en esgrima, 
        con envío a todo el país y atención personalizada.
      </p>

      <!-- CTA -->
      <div class="flex flex-wrap gap-3">
        <a
          href="#filtros-container"
          class="inline-flex items-center gap-2 bg-accent text-text-inverse font-semibold px-6 py-3 rounded-xl hover:bg-accent-light transition-all duration-200 shadow-md shadow-accent/30 hover:shadow-lg hover:shadow-accent/40"
        >
          <i class="fa-solid fa-magnifying-glass text-sm"></i>
          Explorar proveedores
        </a>
        <a
          href="/contacto"
          class="inline-flex items-center gap-2 bg-text-inverse/10 border border-text-inverse/20 text-text-inverse font-semibold px-6 py-3 rounded-xl hover:bg-text-inverse/20 transition-all duration-200"
        >
          <i class="fa-solid fa-briefcase text-sm"></i>
          Publicar mi negocio
        </a>
      </div>
    </div>

    <!-- Columna Derecha: Stats -->
    <div class="grid grid-cols-3 gap-3 lg:gap-4 shrink-0">
      <!-- Stat: Proveedores -->
      <div class="bg-background rounded-2xl px-4 py-4 lg:px-6 lg:py-5 text-center shadow-md shadow-primary/10 min-w-[100px]">
        <p class="text-3xl lg:text-4xl font-bold font-heading text-accent leading-none">
          {totalProveedores}
        </p>
        <p class="text-[10px] lg:text-xs uppercase tracking-wider text-text-muted font-semibold mt-1.5">
          Proveedores
        </p>
      </div>

      <!-- Stat: Tipos -->
      <div class="bg-background rounded-2xl px-4 py-4 lg:px-6 lg:py-5 text-center shadow-md shadow-primary/10 min-w-[100px]">
        <p class="text-3xl lg:text-4xl font-bold font-heading text-accent leading-none">
          {tipos.length}
        </p>
        <p class="text-[10px] lg:text-xs uppercase tracking-wider text-text-muted font-semibold mt-1.5">
          Tipos
        </p>
      </div>

      <!-- Stat: Destacados -->
      <div class="bg-background rounded-2xl px-4 py-4 lg:px-6 lg:py-5 text-center shadow-md shadow-primary/10 min-w-[100px]">
        <p class="text-3xl lg:text-4xl font-bold font-heading text-accent leading-none">
          {totalDestacados}
        </p>
        <p class="text-[10px] lg:text-xs uppercase tracking-wider text-text-muted font-semibold mt-1.5">
          Destacados
        </p>
      </div>
    </div>
  </div>
</div>

    <!-- 🔥 FILTROS POR CATEGORÍA -->
    <div class="mb-8" id="filtros-container">
      <h2 class="text-sm font-semibold text-text-muted mb-3 flex items-center gap-2">
        <i class="fa-solid fa-tag text-primary text-xs"></i>
        Categorías
      </h2>
      <div class="flex flex-wrap gap-2" id="categorias-buttons">
        <button 
          data-categoria=""
          class="filtro-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-primary text-text-inverse"
        >
          Todos
        </button>
        {categorias.map((cat) => (
          <button
            data-categoria={cat}
            class="filtro-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-surface-muted/40 text-text-muted hover:bg-surface-muted"
          >
            {cat}
          </button>
        ))}
      </div>
      <p class="text-xs text-text-soft mt-2">
        <i class="fa-solid fa-circle-info mr-1"></i>
        Haz clic en una categoría para filtrar los proveedores.
      </p>
    </div>

    

    <!-- Grid de Proveedores -->
    <div id="proveedores-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {proveedoresPagina.map((proveedor) => (
        <div 
          class="proveedor-card bg-surface rounded-2xl shadow-md shadow-primary/5 hover:shadow-xl hover:shadow-primary/10 transition-all duration-300 border border-border/50 hover:border-border group overflow-hidden"
          data-categoria={proveedor.categoria}
        >
          <!-- Imagen de portada -->
          {proveedor.imagen_portada && (
            <div class="h-40 bg-surface-muted/40 overflow-hidden">
              <img 
                src={proveedor.imagen_portada} 
                alt={proveedor.nombre} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
          )}
          
          <div class="p-6">
            <!-- Logo y header -->
            <div class="flex items-start gap-4">
              {proveedor.logo && (
                <img 
                  src={proveedor.logo} 
                  alt={proveedor.nombre} 
                  class="w-16 h-16 rounded-2xl object-cover border-2 border-surface-muted bg-surface shrink-0"
                  loading="lazy"
                />
              )}
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="text-lg font-bold text-text group-hover:text-primary-light transition-colors line-clamp-2">
                    {proveedor.nombre}
                  </h3>
                  {proveedor.destacado && (
                    <span class="flex items-center gap-1 text-xs bg-accent/10 text-accent px-2 py-1 rounded-full font-semibold whitespace-nowrap">
                      <i class="fa-solid fa-star text-[10px]"></i>
                      Destacado
                    </span>
                  )}
                </div>
                <div class="flex flex-wrap gap-1 mt-1.5">
                  <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full font-medium">
                    {proveedor.tipo}
                  </span>
                  <span class="text-xs bg-surface-muted/40 text-text-muted px-2 py-0.5 rounded-full">
                    {proveedor.categoria}
                  </span>
                </div>
              </div>
            </div>

            <!-- Descripción -->
            <p class="text-sm text-text-muted mt-3 line-clamp-3">
              {proveedor.descripcion}
            </p>

            <!-- Servicios -->
            {proveedor.servicios && proveedor.servicios.length > 0 && (
              <div class="flex flex-wrap gap-1 mt-3">
                {proveedor.servicios.slice(0, 3).map((servicio) => (
                  <span class="text-xs bg-background text-text-muted px-2 py-0.5 rounded-full border border-border/40">
                    {servicio}
                  </span>
                ))}
                {proveedor.servicios.length > 3 && (
                  <span class="text-xs text-text-soft">+{proveedor.servicios.length - 3}</span>
                )}
              </div>
            )}

            <!-- Datos de contacto -->
            <div class="mt-4 space-y-1.5 text-sm border-t border-border/40 pt-4">
              {proveedor.direccion && proveedor.direccion !== 'Online' && (
                <p class="text-text-muted flex items-start gap-2">
                  <i class="fa-solid fa-location-dot text-primary shrink-0 mt-0.5 text-xs"></i>
                  <span>{proveedor.direccion}</span>
                </p>
              )}
              {proveedor.telefono && (
                <p class="text-text-muted flex items-center gap-2">
                  <i class="fa-solid fa-phone text-primary shrink-0 text-xs"></i>
                  <a href={`tel:${proveedor.telefono}`} class="hover:text-primary transition-colors">
                    {proveedor.telefono}
                  </a>
                </p>
              )}
              {proveedor.email && (
                <p class="text-text-muted flex items-center gap-2">
                  <i class="fa-regular fa-envelope text-primary shrink-0 text-xs"></i>
                  <a href={`mailto:${proveedor.email}`} class="hover:text-primary transition-colors truncate">
                    {proveedor.email}
                  </a>
                </p>
              )}
            </div>

            <!-- Acciones -->
            <div class="mt-4 pt-4 border-t border-border/40 flex flex-wrap items-center gap-2">
              <div class="flex gap-2">
                {proveedor.instagram && (
                  <a 
                    href={proveedor.instagram} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="w-8 h-8 flex items-center justify-center bg-accent/10 text-accent rounded-xl hover:bg-accent hover:text-text-inverse transition-colors"
                    title="Instagram"
                  >
                    <i class="fa-brands fa-instagram text-sm"></i>
                  </a>
                )}
                {proveedor.whatsapp && (
                  <a 
                    href={proveedor.whatsapp} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="w-8 h-8 flex items-center justify-center bg-primary-light/10 text-primary-light rounded-xl hover:bg-primary-light hover:text-text-inverse transition-colors"
                    title="WhatsApp"
                  >
                    <i class="fa-brands fa-whatsapp text-sm"></i>
                  </a>
                )}
                {proveedor.web && (
                  <a 
                    href={proveedor.web} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="w-8 h-8 flex items-center justify-center bg-primary/10 text-primary rounded-xl hover:bg-primary hover:text-text-inverse transition-colors"
                    title="Sitio web"
                  >
                    <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                  </a>
                )}
              </div>                   
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Mensaje cuando no hay resultados -->
    <div id="no-resultados" class="hidden bg-surface rounded-3xl shadow-md shadow-primary/5 p-12 text-center border-2 border-dashed border-border mt-8">
      <div class="w-20 h-20 mx-auto bg-surface-muted/40 rounded-2xl flex items-center justify-center mb-4">
        <i class="fa-solid fa-magnifying-glass text-3xl text-text-soft"></i>
      </div>
      <h3 class="text-xl font-bold text-text mb-2">No hay proveedores</h3>
      <p class="text-text-muted">No se encontraron proveedores para esta categoría.</p>
      <button id="ver-todos-btn" class="text-primary hover:text-accent transition-colors mt-4 inline-flex items-center gap-1.5 font-semibold">
        <i class="fa-solid fa-arrow-left text-xs"></i>
        Ver todos los proveedores
      </button>
    </div>

    <!-- Paginación -->
    {totalPaginas > 1 && (
      <div class="mt-8 flex justify-center items-center gap-2 flex-wrap">
        {paginaActual > 1 && (
          <a
            href={`/proveedores?page=${paginaActual - 1}`}
            class="px-4 py-2 bg-surface-muted/40 text-text-muted rounded-xl hover:bg-surface-muted transition-colors font-medium"
          >
            <i class="fa-solid fa-chevron-left mr-1 text-xs"></i>
            Anterior
          </a>
        )}

        {Array.from({ length: totalPaginas }, (_, i) => i + 1).map((p) => {
          const isFirst = p === 1;
          const isLast = p === totalPaginas;
          const isCurrent = p === paginaActual;
          const isNearCurrent = Math.abs(p - paginaActual) < 2;
          const shouldShow = isFirst || isLast || isCurrent || isNearCurrent;

          if (!shouldShow) {
            if (p === paginaActual - 3 || p === paginaActual + 3) {
              return <span class="px-2 text-text-soft">…</span>;
            }
            return null;
          }

          return (
            <a
              href={`/proveedores?page=${p}`}
              class={`px-4 py-2 rounded-xl transition-colors font-medium ${
                isCurrent
                  ? 'bg-primary text-text-inverse'
                  : 'bg-surface-muted/40 text-text-muted hover:bg-surface-muted'
              }`}
            >
              {p}
            </a>
          );
        })}

        {paginaActual < totalPaginas && (
          <a
            href={`/proveedores?page=${paginaActual + 1}`}
            class="px-4 py-2 bg-surface-muted/40 text-text-muted rounded-xl hover:bg-surface-muted transition-colors font-medium"
          >
            Siguiente
            <i class="fa-solid fa-chevron-right ml-1 text-xs"></i>
          </a>
        )}
      </div>
    )}

    <!-- Total de proveedores -->
    <div class="mt-6 text-center text-sm text-text-muted">
      <i class="fa-solid fa-circle-info mr-1 text-text-soft"></i>
      Mostrando {inicio + 1} - {Math.min(fin, totalProveedores)} de {totalProveedores} proveedores
    </div>

   <BannerPub 
      titulo="¿Quieres que tu marca llegue a todos los esgrimistas de Venezuela?"
      descripcion="Publica aquí y conecta con miles de atletas, clubes y entrenadores."
      texto="Contacta con nosotros"
      url="/contacto"       
    />
  </div>
</Layout> 

<!-- 🔥 JAVASCRIPT VANILLA PARA FILTROS -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 🔹 Capturar elementos con tipado correcto
    const filtros = document.querySelectorAll<HTMLElement>('.filtro-btn');
    const cards = document.querySelectorAll<HTMLElement>('.proveedor-card');
    const noResultados = document.getElementById('no-resultados');
    const verTodosBtn = document.getElementById('ver-todos-btn');

    // ✅ Salida temprana: si falta lo esencial, no seguimos
    if (!noResultados) return;

    // 🔹 Estado actual del filtro
    let categoriaActual = '';

    // 🔹 Función para filtrar
    function filtrarProveedores(categoria: string) {
      categoriaActual = categoria;
      let hayResultados = false;

      cards.forEach((card) => {
        const cardCategoria = card.dataset.categoria ?? '';
        if (categoria === '' || cardCategoria === categoria) {
          card.style.display = '';
          hayResultados = true;
        } else {
          card.style.display = 'none';
        }
      });

      // Mostrar/ocultar mensaje de "sin resultados"
      if (hayResultados) {
        noResultados!.classList.add('hidden');
      } else {
        noResultados!.classList.remove('hidden');
      }

      // Actualizar estilos de los botones
      filtros.forEach((btn) => {
        const btnCategoria = btn.dataset.categoria ?? '';
        if (btnCategoria === categoria) {
          btn.className = 'filtro-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-primary text-text-inverse';
        } else {
          btn.className = 'filtro-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-surface-muted/40 text-text-muted hover:bg-surface-muted';
        }
      });
    }

    // 🔹 Evento de clic en botones de filtro
    filtros.forEach((btn) => {
      btn.addEventListener('click', function () {
        const categoria = btn.dataset.categoria ?? '';
        filtrarProveedores(categoria);
      });
    });

    // 🔹 Evento para "Ver todos"
    if (verTodosBtn) {
      verTodosBtn.addEventListener('click', function () {
        filtrarProveedores('');
      });
    }

    // 🔹 Cargar filtro desde URL (si existe)
    const urlParams = new URLSearchParams(window.location.search);
    const categoriaParam = urlParams.get('categoria');
    if (categoriaParam) {
      const btn = document.querySelector<HTMLElement>(
        `.filtro-btn[data-categoria="${categoriaParam}"]`
      );
      if (btn) {
        btn.click();
      }
    }
  });
</script>