---
import Layout from '../layouts/LayoutBase.astro'; 
import Buscador from '../components/react/Buscador.jsx';
import ClubCard from '../components/clubes/ClubCard.astro';
import { 
  getTodosClubes, 
  getProveedores,
  getClubesDestacados
} from '../utils/dataLoader';
 

// 🔥 Cargar datos
const clubes = await getTodosClubes();
const proveedores = await getProveedores();
const clubesDestacados = await getClubesDestacados(6);

// 🔥 Estadísticas
const totalClubes = clubes.length;
const totalProveedores = proveedores.length;
const totalItems = totalClubes + totalProveedores;

// 🔥 Datos para las secciones de valor
const seccionesValor = [
  {
    titulo: 'Directorio de Clubes',
    descripcion: 'Encuentra el club de esgrima más cercano a ti. Filtra por estado, ciudad y especialidad para encontrar tu lugar ideal.',
    icono: 'fa-solid fa-lightbulb',
    enlace: '/clubes',
    enlaceTexto: 'Ver clubes',
    color: 'bg-blue-50 border-blue-200'
  },
  {
    titulo: 'Proveedores y Material',
    descripcion: 'Conecta con los mejores proveedores de material de esgrima. Desde tiendas físicas hasta talleres de reparación.',
    icono: 'fa-solid fa-shopping-bag',
    enlace: '/proveedores',
    enlaceTexto: 'Ver proveedores',
    color: 'bg-green-50 border-green-200'
  },
  {
    titulo: 'Guías de Compra',
    descripcion: 'Elige el equipo perfecto con nuestras guías comparativas. Zapatillas, caretas, trajes y más.',
    icono: 'fa-solid fa-book-open',
    enlace: '/guias',
    enlaceTexto: 'Ver guías',
    color: 'bg-gold/10 border-gold/30'
  },
  {
    titulo: 'Como Crear un Club de Esgrima',
    descripcion: 'Conoce los requisitos más importantes y necesarios para montar un club de esgrima en Venezuela.',
    icono: 'fa-solid fa-file-text',
    enlace: '/guias/montar-club',
    enlaceTexto: 'Ver info',
    color: 'bg-purple-50 border-purple-200'
  }
];

// 🔥 Datos para el banner
const banner = {
  titulo: '¿Quieres promocionar tu club o negocio de esgrima?',
  descripcion: 'Llega a miles de esgrimistas, entrenadores y clubes en todo el país. Publicita tu negocio en el directorio más completo de esgrima en Venezuela.',
  imagen: '/images/banner-publicidad.jpg'
};

// 🔥 Datos para la CTA final
const cta = {
  titulo: '¿Listo para empezar tu entrenamiento de esgrima?',
  descripcion: 'Encuentra clubes, proveedores y todo el equipamiento que necesitas para practicar este deporte apasionante.',
  boton1: 'Buscar clubes',
  enlace1: '/clubes',
  boton2: 'No sabes? Contactanos!',
  enlace2: '/contacto'
};
---

 <Layout>
  <main>
    <!-- Hero Section con Buscador -->
    <section class="relative bg-[url(/images/bg-1.jpg)] bg-cover bg-center py-16 md:py-24 text-text-inverse">
      <!-- Overlay -->
      <div class="absolute inset-0 bg-linear-to-r from-primary-dark/90 via-primary/85 to-primary-light/75"></div>
      
      <div class="relative container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-4 font-heading">
          Escuelas de Esgrima  
           <span class="underline decoration-amber-200 decoration-4 underline-offset-4"> En Venezuela</span>
        </h1>
        <p class="text-xl md:text-2xl mb-4 opacity-90 max-w-2xl mx-auto">
          El directorio más completo de clubes de esgrima en Venezuela
        </p>
        <p class="text-lg mb-8 opacity-80 max-w-2xl mx-auto">
          Hemos recopilado los mejores gimnasios, academias, escuelas, clubes de esgrima y proveedores de equipamiento en toda Venezuela para que compares precios, horarios y niveles lo más cerca de ti.
        </p>
        
        <!-- 🔥 BUSCADOR GLOBAL -->
        <Buscador 
          client:load
          clubes={clubes}
          proveedores={proveedores}
          placeholder="Buscar clubes, proveedores, ciudades, materiales..."
          className="max-w-3xl mx-auto"
        />
        
        <div class="mt-6 flex flex-wrap justify-center gap-4 text-sm opacity-90">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            {totalClubes} clubes
          </span>
          <span class="w-px h-4 bg-text-inverse/25"></span>
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            {totalProveedores} proveedores
          </span>
          <span class="w-px h-4 bg-text-inverse/25"></span>
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            {totalItems} resultados disponibles
          </span>
        </div>
      </div>
    </section>

    <!-- 🔥 SECCIÓN: Lo que ofrecemos (Valor) -->
    <section class="py-16 bg-background">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold font-heading mb-3 text-text">
            Todo lo que necesitas para la esgrima
          </h2>
          <p class="text-text-muted max-w-2xl mx-auto">
            Un ecosistema completo para conectar esgrimistas, clubes y proveedores en un solo lugar.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
          {seccionesValor.map((seccion) => (
            <div class={`rounded-2xl p-6 border border-border/60 bg-surface transition-all duration-300 hover:shadow-lg hover:shadow-primary/5 hover:-translate-y-1 ${seccion.color}`}>
              <div class="w-14 h-14 bg-surface-muted/60 rounded-2xl flex items-center justify-center mb-4">
                <i class={`${seccion.icono} text-2xl text-primary`}></i>
              </div>
              <h3 class="text-xl font-bold font-heading text-text mb-2">
                {seccion.titulo}
              </h3>
              <p class="text-sm text-text-muted mb-4">
                {seccion.descripcion}
              </p>
              <a 
                href={seccion.enlace} 
                class="text-sm font-semibold text-primary hover:text-accent transition-colors inline-flex items-center gap-1"
              >
                {seccion.enlaceTexto}
                <i class="fa-solid fa-chevron-right text-xs"></i>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 🔥 SECCIÓN: Banner Publicitario -->
    <section class="py-12 bg-background">
      <div class="container mx-auto px-4">
        <div class="bg-linear-to-r from-primary to-primary-light rounded-3xl p-8 md:p-12 text-text-inverse overflow-hidden relative">
          <div class="flex flex-col md:flex-row md:items-center gap-6">
            <div class="flex-1">
              <div class="flex items-center gap-2 text-accent mb-2">
                <i class="fa-solid fa-star text-sm"></i>
                <span class="text-sm font-semibold">Espacio Publicitario</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold font-heading mb-3">
                {banner.titulo}
              </h3>
              <p class="text-surface-muted text-sm md:text-base max-w-lg">
                {banner.descripcion}
              </p>
              <div class="mt-6 flex flex-wrap gap-3">
                <a 
                  href="/contacto" 
                  class="inline-flex items-center gap-2 bg-accent text-text-inverse font-semibold px-6 py-2.5 rounded-xl hover:bg-accent-light transition shadow-lg shadow-accent/20"
                >
                  <i class="fa-solid fa-arrow-trend-up"></i>
                  Contrata aquí
                </a>
                <a 
                  href="/proveedores" 
                  class="inline-block bg-text-inverse/10 text-text-inverse font-semibold px-6 py-2.5 rounded-xl hover:bg-text-inverse/20 transition border border-text-inverse/20"
                >
                  Ver proveedores
                </a>
              </div>
            </div>
            <div class="shrink-0">
              <div class="bg-text-inverse/10 rounded-2xl p-6 text-center w-32 md:w-40 mx-auto border border-text-inverse/10">
                <i class="fa-solid fa-bullseye text-4xl text-accent mx-auto"></i>
                <p class="text-xs text-surface-muted mt-2">Llega a miles</p>
                <p class="text-lg font-bold text-accent">+{totalItems}</p>
                <p class="text-[10px] text-surface-muted/70">usuarios potenciales</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Clubes Destacados -->
    <section class="py-16 bg-background">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold font-heading mb-3 text-text">
            Clubes Destacados
          </h2>
          <p class="text-text-muted max-w-2xl mx-auto">
            Los clubes más reconocidos de Venezuela. Encuentra el tuyo y empieza a practicar esgrima.
          </p>
        </div>
        
        {clubesDestacados.length > 0 ? (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
              {clubesDestacados.map((club) => (
                <ClubCard club={club} />
              ))}
            </div>
            <div class="text-center mt-8">
              <a 
                href="/clubes" 
                class="inline-flex items-center gap-2 px-8 py-3 bg-primary text-text-inverse rounded-xl hover:bg-primary-light transition shadow-md shadow-primary/10"
              >
                Ver todos los clubes 
                <i class="fa-solid fa-chevron-right text-xs"></i>
              </a>
            </div>
          </>
        ) : (
          <p class="text-center text-text-soft">No hay clubes destacados disponibles.</p>
        )}
      </div>
    </section>

    <!-- 🔥 SECCIÓN: Llamada a la acción final (CTA) -->
    <section class="py-10 bg-background">
      <div class="container mx-auto px-4 text-center">
        <div class="bg-surface-muted/30 rounded-3xl shadow-lg shadow-primary/5 p-8 md:p-12 border border-border/50">
          <div class="w-16 h-16 bg-surface-muted/60 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-award text-2xl text-primary"></i>
          </div>
          <h2 class="text-2xl md:text-3xl font-bold font-heading mb-3 text-text">
            {cta.titulo}
          </h2>
          <p class="text-text-muted mb-6">
            {cta.descripcion}
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a 
              href={cta.enlace1} 
              class="inline-flex items-center gap-2 px-8 py-3 bg-primary text-text-inverse rounded-xl hover:bg-primary-light transition shadow-md hover:shadow-lg shadow-primary/10"
            >
              <i class="fa-solid fa-location-dot"></i>
              {cta.boton1}
            </a>
            <a 
              href={cta.enlace2} 
              class="inline-flex items-center gap-2 px-8 py-3 bg-surface text-primary rounded-xl hover:bg-surface-muted/50 transition border border-border"
            >
              <i class="fa-solid fa-shield-halved"></i>
              {cta.boton2}
            </a>
          </div>
          <div class="mt-6 pt-6 border-t border-border/50 flex flex-wrap justify-center gap-4 text-sm font-bold">
            <span class="flex items-center gap-2 bg-primary text-text-inverse px-4 py-2 rounded-2xl">
              <i class="fa-solid fa-bolt text-accent"></i>
              Gratis para clubes
            </span>
            <span class="flex items-center gap-2 bg-primary text-text-inverse px-4 py-2 rounded-2xl">
              <i class="fa-solid fa-users text-accent"></i>
              {totalClubes} clubes
            </span>
            <span class="flex items-center gap-2 bg-primary text-text-inverse px-4 py-2 rounded-2xl">
              <i class="fa-solid fa-bag-shopping text-accent"></i>
              {totalProveedores} proveedores
            </span>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>