---
// src/components/clubes/ClubCard.astro
import { FiMapPin, FiCalendar, FiStar } from 'react-icons/fi';

interface Props {
  club: {
    id?: string;
    slug: string;
    nombre: string;
    estado: string;
    estado_slug?: string;
    ciudad: string;
    ciudad_slug?: string;
    especialidad: string;
    edades: string;
    logo?: string;
    imagen_portada?: string;
    descripcion?: string;
    destacado?: boolean;
    fundador?: string;
    entrenadores?: Array<{ nombre: string; especialidad: string }>;
  };
}

const { club } = Astro.props;

// Generar URL para el club
const clubSlug = club.slug || club.id || '';
const estadoSlug = club.estado_slug || club.estado?.toLowerCase().replace(/\s+/g, '-') || '';
const ciudadSlug = club.ciudad_slug || club.ciudad?.toLowerCase().replace(/\s+/g, '-') || '';
const clubUrl = `/clubes/${estadoSlug}-${ciudadSlug}-${clubSlug}`;
---

<a 
  href={clubUrl}
  class="group bg-white rounded-xl shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300 border border-gray-100 overflow-hidden block"
>
  {/* Imagen de portada */}
  {club.imagen_portada && (
    <div class="h-40 bg-gray-200 overflow-hidden">
      <img 
        src={club.imagen_portada} 
        alt={club.nombre} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </div>
  )}
  
  <div class="p-5">
    {/* Logo + Nombre */}
    <div class="flex items-start gap-3">
      {club.logo && (
        <img 
          src={club.logo} 
          alt={club.nombre} 
          class="w-14 h-14 rounded-full object-cover border-2 border-gray-200 flex-shrink-0"
          loading="lazy"
        />
      )}
      <div class="flex-1 min-w-0">
        <div class="flex items-start justify-between gap-2">
          <h3 class="text-lg font-bold text-primary group-hover:text-gold transition-colors line-clamp-2">
            {club.nombre}
          </h3>
          {club.destacado && (
            <span class="flex items-center gap-1 text-xs bg-gold/20 text-gold-dark px-2 py-1 rounded-full font-semibold whitespace-nowrap">
              <FiStar className="w-3 h-3" />
              Destacado
            </span>
          )}
        </div>
        <p class="text-sm text-gray-500 flex items-center gap-1 mt-0.5">
          <FiMapPin className="w-3 h-3" />
          {club.ciudad}
        </p>
      </div>
    </div>

    {/* Especialidad y edades */}
    <div class="flex flex-wrap gap-2 mt-3">
      <span class="text-xs bg-primary/10 text-primary px-3 py-1 rounded-full">
        {club.especialidad}
      </span>
      <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full flex items-center gap-1">
        <FiCalendar className="w-3 h-3" />
        {club.edades}
      </span>
      {club.entrenadores && club.entrenadores.length > 0 && (
        <span class="text-xs bg-blue-50 text-blue-600 px-3 py-1 rounded-full">
          {club.entrenadores.length} entrenadores
        </span>
      )}
    </div>

    {/* Descripción */}
    {club.descripcion && (
      <p class="text-sm text-gray-600 mt-3 line-clamp-2">
        {club.descripcion}
      </p>
    )}

    {/* Fundador */}
    {club.fundador && (
      <p class="text-xs text-gray-400 mt-2">
        Contacto: {club.fundador}
      </p>
    )}

    {/* Footer del card */}
    <div class="mt-4 pt-4 border-t border-gray-100 flex justify-between items-center">
      <span class="text-xs text-primary font-medium group-hover:text-indigo-600 transition-colors">
        Ver detalles →
      </span>
      
    </div>
  </div>
</a>