---
// src/components/clubes/ClubCard.astro
import { FiMapPin, FiCalendar, FiStar } from 'react-icons/fi';

interface Props {
  club: {
    id?: string;
    slug: string;
    nombre: string;
    estado: string;
    estado_slug?: string;
    ciudad: string;
    ciudad_slug?: string;
    especialidad: string;
    edades: string;
    logo?: string;
    imagen_portada?: string;
    descripcion?: string;
    destacado?: boolean;
    fundador?: string;
    entrenadores?: Array<{ nombre: string; especialidad: string }>;
  };
}

const { club } = Astro.props;

// Generar URL para el club
const clubSlug = club.slug || club.id || '';
const estadoSlug = club.estado_slug || club.estado?.toLowerCase().replace(/\s+/g, '-') || '';
const ciudadSlug = club.ciudad_slug || club.ciudad?.toLowerCase().replace(/\s+/g, '-') || '';
const clubUrl = `/clubes/${estadoSlug}-${ciudadSlug}-${clubSlug}`;
---

 <a 
  href={clubUrl}
  class="group bg-surface rounded-2xl shadow-md shadow-primary/5 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-1.5 transition-all duration-300 border border-border/50 hover:border-border overflow-hidden block"
>
  {/* Imagen de portada */}
  {club.imagen_portada && (
    <div class="h-40 bg-surface-muted/40 overflow-hidden">
      <img 
        src={club.imagen_portada} 
        alt={club.nombre} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
  )}
  
  <div class="p-5">
    {/* Logo + Nombre */}
    <div class="flex items-start gap-3">
      {club.logo && (
        <img 
          src={club.logo} 
          alt={club.nombre} 
          class="w-14 h-14 rounded-2xl object-cover border-2 border-surface-muted shrink-0 bg-surface"
          loading="lazy"
        />
      )}
      <div class="flex-1 min-w-0">
        <div class="flex items-start justify-between gap-2">
          <h3 class="text-xs lg:text-lg font-bold text-text group-hover:text-primary-light transition-colors">
            {club.nombre}
          </h3>
          {club.destacado && (
            <span class="flex items-center gap-1 text-xs bg-accent/10 text-accent px-2 py-1 rounded-full font-semibold whitespace-nowrap">
              <i class="fa-solid fa-star text-[10px]"></i>
              Destacado
            </span>
          )}
        </div>
        <p class="text-sm text-text-muted flex items-center gap-1 mt-0.5">
          <i class="fa-solid fa-location-dot text-xs"></i>
          {club.ciudad}
        </p>
      </div>
    </div>

    {/* Especialidad y edades */}
    <div class="flex flex-wrap gap-2 mt-3">
      <span class="text-xs bg-primary/10 text-primary px-3 py-1 rounded-full font-medium">
        {club.especialidad}
      </span>
      <span class="text-xs bg-surface-muted/40 text-text-muted px-3 py-1 rounded-full flex items-center gap-1">
        <i class="fa-regular fa-calendar text-[10px]"></i>
        {club.edades}
      </span>
      {club.entrenadores && club.entrenadores.length > 0 && (
        <span class="text-xs bg-primary-light/10 text-primary-light px-3 py-1 rounded-full">
          {club.entrenadores.length} entrenadores
        </span>
      )}
    </div>

    {/* Descripción */}
    {club.descripcion && (
      <p class="text-sm text-text-muted mt-3 line-clamp-2">
        {club.descripcion}
      </p>
    )}

    {/* Fundador */}
    {club.fundador && (
      <p class="text-xs text-text-soft mt-2">
        Contacto: {club.fundador}
      </p>
    )}

    {/* Footer del card */}
    <div class="mt-4 pt-4 border-t border-border/40 flex justify-between items-center">
      <span class="text-xs text-primary font-semibold group-hover:text-accent transition-colors inline-flex items-center gap-1">
        Ver detalles
        <i class="fa-solid fa-arrow-right text-[10px] transition-transform group-hover:translate-x-0.5"></i>
      </span>
    </div>
  </div>
</a>