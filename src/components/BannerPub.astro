---

interface Props {
  titulo: string,
  descripcion: string,
  texto: string,
  url: string,
  target?: string
}

 

const { titulo, descripcion, texto, url, target = "_self" } = Astro.props;
---

<!-- Banner Publicitario -->
<div class="bg-linear-to-r from-primary to-primary-light rounded-3xl p-6 md:p-8 my-8 text-text-inverse shadow-lg shadow-primary/10 relative overflow-hidden">
  <!-- Detalle decorativo sutil -->
  <div class="absolute -top-12 -right-12 w-40 h-40 rounded-full bg-text-inverse/5 blur-2xl pointer-events-none"></div>
  
  <div class="relative text-center">
    <p class="text-xs uppercase tracking-widest text-surface-muted/80 mb-2 font-semibold">
      <i class="fa-solid fa-bullhorn text-accent mr-1.5"></i>
      Espacio publicitario
    </p>
    <h4 class="text-xl md:text-2xl font-bold font-heading mb-2">
      {titulo}
    </h4>
    <p class="text-surface-muted text-sm mb-4 max-w-xl mx-auto">
      {descripcion}
    </p>
    <a 
      href={url}
      target={target}
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 bg-accent text-text-inverse font-semibold px-6 py-2.5 rounded-xl hover:bg-accent-light transition-all duration-200 shadow-md shadow-accent/20"
    >
      {texto}
      <i class="fa-solid fa-arrow-right text-xs"></i>
    </a>
  </div>
</div>