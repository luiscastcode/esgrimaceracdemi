---  

interface Props {
  titulo: String,
  descripcion: String,
  textobtn: String,
  url: String
}

const { titulo, descripcion, textobtn, url } = Astro.props;
---

  <!-- CALL TO ACTION - Contrata publicidad -->
<div class="bg-surface-muted/30 border border-border rounded-3xl p-6 md:p-8 my-8 shadow-md shadow-primary/5">
  <div class="flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="text-left">
      <h3 class="text-xl font-bold font-heading text-text flex items-center gap-2">
        <i class="fa-solid fa-star text-accent"></i>
        {titulo}
      </h3>
      <p class="text-text-muted text-sm mt-1">
        {descripcion}
      </p>
    </div>
    <a 
      href={`/${url}`}
      class="inline-flex items-center gap-2 bg-accent text-text-inverse font-semibold px-8 py-3 rounded-xl hover:bg-accent-light hover:shadow-lg hover:shadow-accent/30 transition-all duration-200 whitespace-nowrap shadow-md shadow-accent/20"
    >
      <i class="fa-solid fa-briefcase"></i>
      {textobtn}
    </a>
  </div>
</div>