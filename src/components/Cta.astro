---
import { 
   
  FiBriefcase,   FiStar
} from 'react-icons/fi';

interface Props {
  titulo: String,
  descripcion: String,
  textobtn: String,
  url: String
}

const { titulo, descripcion, textobtn, url } = Astro.props;
---

 <!-- CALL TO ACTION - Contrata publicidad -->
    <div class="bg-gold/10 border-2 border-gold rounded-2xl p-6 md:p-8 my-8 text-center">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="text-left">
          <h3 class="text-xl font-bold font-heading text-primary flex items-center gap-2">
            <FiStar className="w-6 h-6 text-gold" />
            {titulo}
          </h3>
          <p class="text-gray-600 text-sm mt-1">
            {descripcion}
          </p>
        </div>
        <a 
          href={`/${url}`}
          class="bg-gold text-primary font-semibold px-8 py-3 rounded-xl hover:bg-gold-light hover:shadow-lg transition-all duration-200 whitespace-nowrap flex items-center gap-2"
        >
          <FiBriefcase className="w-4 h-4" />
          {textobtn}
        </a>
      </div>
    </div>